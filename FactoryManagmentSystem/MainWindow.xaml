<Window x:Class="FactoryManagmentSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactoryManagmentSystem"
        mc:Ignorable="d"
        Title="Garment Factory Management System - Login" 
        Height="800" Width="1400" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <!-- Modern Bright Gradient Brushes -->
        <LinearGradientBrush x:Key="BrightBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A8E6CF" Offset="0"/>
            <GradientStop Color="#FFD3B6" Offset="0.3"/>
            <GradientStop Color="#FFAAA5" Offset="0.6"/>
            <GradientStop Color="#FF8B94" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="ButtonHoverGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#764ba2" Offset="0"/>
            <GradientStop Color="#667eea" Offset="1"/>
        </LinearGradientBrush>
        

        
        <!-- Fade In Animation -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetName="LoginCard" 
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LoginCard" 
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="50" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <!-- Sleek Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="BorderBrush" Value="#DFE6E9"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <ContentPresenter Name="ContentSite" 
                                                IsHitTestVisible="False" 
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                Margin="{TemplateBinding Padding}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"/>
                                <ToggleButton Name="ToggleButton" 
                                            Template="{DynamicResource ComboBoxToggleButton}" 
                                            Grid.Column="2" 
                                            Focusable="false"
                                            IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                            ClickMode="Press"/>
                                <Popup Name="Popup" 
                                     Placement="Bottom"
                                     IsOpen="{TemplateBinding IsDropDownOpen}"
                                     AllowsTransparency="True" 
                                     Focusable="False"
                                     PopupAnimation="Slide">
                                    <Border Name="DropDownBorder" 
                                          Background="White" 
                                          BorderThickness="0"
                                          CornerRadius="12"
                                          Margin="0,4,0,0"
                                          Effect="{DynamicResource DropShadow}">
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHoverGradient}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#667eea" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Drop Shadow Effects -->
        <DropShadowEffect x:Key="DropShadow" Color="#2D3436" Direction="270" ShadowDepth="10" Opacity="0.15" BlurRadius="30"/>
        <DropShadowEffect x:Key="CardShadow" Color="#2D3436" Direction="270" ShadowDepth="20" Opacity="0.1" BlurRadius="40"/>
        
        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Border Grid.ColumnSpan="2" Background="Transparent"/>
                <Path x:Name="Arrow" Grid.Column="1" 
                      Fill="#636E72" 
                      HorizontalAlignment="Right" 
                      VerticalAlignment="Center" 
                      Data="M 0 0 L 5 5 L 10 0 Z"
                      Margin="0,0,16,0"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <Grid>
        <!-- Bright Modern Background -->
        <Grid.Background>
            <StaticResource ResourceKey="BrightBackground"/>
        </Grid.Background>
        
        <!-- Decorative Circles -->
        <Ellipse Width="400" Height="400" Fill="#FFD3B6" Opacity="0.3" 
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-200,0,0"/>
        <Ellipse Width="300" Height="300" Fill="#FFAAA5" Opacity="0.3" 
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-150"/>
        <Ellipse Width="250" Height="250" Fill="#A8E6CF" Opacity="0.3" 
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,-100,0"/>
        
        <!-- Close Button -->
        <Button Name="CloseButton" Content="✕" 
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="48" Height="48" Margin="0,20,20,0"
                Background="#FF6B6B" Foreground="White"
                BorderThickness="0" FontSize="20" FontWeight="Bold"
                Click="CloseButton_Click" Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" 
                                       CornerRadius="24">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EE5A6F"/>
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#FF6B6B" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        
        <!-- Main Login Container -->
        <Border Name="LoginCard" 
                Width="520" Height="auto"
                MaxHeight="750"
                CornerRadius="30"
                Effect="{StaticResource CardShadow}"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                Background="White"
                Padding="50,45">
            <Border.RenderTransform>
                <TranslateTransform Y="50"/>
            </Border.RenderTransform>
            
            <StackPanel VerticalAlignment="Center">
                <!-- Logo/Icon with Gradient -->
                <Border Width="90" Height="90" 
                        CornerRadius="45" 
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="👗" FontSize="50" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
                
                <TextBlock Text="GARMENT FACTORY" 
                           FontSize="30" FontWeight="Bold" 
                           Foreground="#2D3436" TextAlignment="Center" 
                           Margin="0,0,0,5"/>
                
                <TextBlock Text="Management System" 
                           FontSize="15" FontWeight="Normal" 
                           Foreground="#636E72" TextAlignment="Center" 
                           Margin="0,0,0,35"/>
                
                <!-- Role Selection -->
                <TextBlock Text="Select Your Role" 
                           FontSize="14" FontWeight="SemiBold" 
                           Foreground="#2D3436" Margin="0,0,0,8"/>
                
                <ComboBox Name="RoleComboBox" 
                          Style="{StaticResource ModernComboBox}"
                          SelectionChanged="RoleComboBox_SelectionChanged"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="👔 Owner" Foreground="#2D3436" FontSize="15" FontWeight="Medium" Padding="12"/>
                    <ComboBoxItem Content="🛍️ Sales Person" Foreground="#2D3436" FontSize="15" FontWeight="Medium" Padding="12"/>
                    <ComboBoxItem Content="✂️ Tailor" Foreground="#2D3436" FontSize="15" FontWeight="Medium" Padding="12"/>
                    <ComboBoxItem Content="📊 Sales Manager" Foreground="#2D3436" FontSize="15" FontWeight="Medium" Padding="12"/>
                    <ComboBoxItem Content="⚙️ Production Manager" Foreground="#2D3436" FontSize="15" FontWeight="Medium" Padding="12"/>
                    <ComboBoxItem Content="🚚 Delivery Person" Foreground="#2D3436" FontSize="15" FontWeight="Medium" Padding="12"/>
                </ComboBox>
                
                <!-- Username Dropdown -->
                <TextBlock Text="Select Username" 
                           FontSize="14" FontWeight="SemiBold" 
                           Foreground="#2D3436" Margin="0,0,0,8"/>
                
                <ComboBox Name="UsernameComboBox" 
                          Style="{StaticResource ModernComboBox}"
                          SelectionChanged="UsernameComboBox_SelectionChanged"
                          Margin="0,0,0,20"/>
                
                <!-- PIN Dropdown -->
                <TextBlock Text="Select PIN" 
                           FontSize="14" FontWeight="SemiBold" 
                           Foreground="#2D3436" Margin="0,0,0,8"/>
                
                <ComboBox Name="PinComboBox" 
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,30"/>
                
                <!-- Login Button -->
                <Button Name="LoginButton" Content="LOGIN TO DASHBOARD" 
                        Style="{StaticResource ModernButton}"
                        Click="LoginButton_Click"/>
                
                <!-- Status Message -->
                <Border Name="StatusMessageBorder"
                        Background="#FFF3F3" 
                        BorderBrush="#FF6B6B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">
                    <TextBlock Name="StatusMessage" 
                               FontSize="13" 
                               TextAlignment="Center" 
                               Foreground="#FF6B6B"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
