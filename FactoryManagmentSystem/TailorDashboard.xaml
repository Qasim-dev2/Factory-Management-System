<Window x:Class="FactoryManagmentSystem.TailorDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactoryManagmentSystem"
        xmlns:views="clr-namespace:FactoryManagmentSystem.Views"
        mc:Ignorable="d"
        Title="Garments Factory Management System - Tailor Dashboard" 
        Height="800" Width="1400" 
        WindowState="Maximized"
        Background="#1E1E2E">
    
    <Window.Resources>
        <!-- Modern Colors -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#2D3142"/>
        <SolidColorBrush x:Key="MainBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        
        <!-- Sidebar Menu Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Margin="10,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPurple}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Active Sidebar Button Style -->
        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Header Button Style -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Card Style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E5E7EB" Direction="270" ShadowDepth="4" Opacity="0.5" BlurRadius="12"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Logo Section -->
                <Border Grid.Row="0" Background="#1F2937" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🧵" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="Garments Factory" FontSize="16" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Name="WelcomeText" FontSize="12" 
                                   Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <StackPanel>
                        <Button Name="DashboardBtn" Content="📊  Dashboard" Style="{StaticResource ActiveSidebarButton}" 
                                Click="NavigationButton_Click" Tag="Dashboard"/>
                        <Button Name="TailorTasksBtn" Content="👷  My Tasks" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="TailorTasks"/>
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Bottom Section -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Button Content="🚪  Logout" Style="{StaticResource HeaderButton}" 
                            Click="LogoutButton_Click" Margin="10,10"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="{StaticResource MainBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Top Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Name="PageSubtitle" Text="View and manage your assigned tasks" FontSize="14" 
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="20,0,0,5"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="20" Margin="0,0,20,0" Cursor="Hand"/>
                        <Border Background="#F3F4F6" CornerRadius="20" Padding="10,5">
                            <TextBlock Text="Tailor Portal" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Dynamic Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Name="MainContentArea" Margin="30">
                    <!-- Dashboard Content (Default) -->
                    <Grid Name="DashboardContent" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Stats Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Pending Tasks" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Name="PendingTasksCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="🔄" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="In Progress" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Name="InProgressCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="✅" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Completed Today" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Name="CompletedTodayCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Quick Actions -->
                        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="12,0,12,30">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                                <WrapPanel>
                                    <Button Content="👷 View My Tasks" Style="{StaticResource HeaderButton}" 
                                            Background="{StaticResource AccentPurple}" Margin="0,0,10,10"
                                            Click="QuickAction_ViewTasks"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Recent Activity -->
                        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Margin="12,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Recent Activities" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                                <StackPanel Name="RecentActivitiesPanel">
                                    <TextBlock Text="• Welcome to your tailor dashboard!" FontSize="14" Margin="0,5"/>
                                    <TextBlock Text="• View and manage your assigned tasks" FontSize="14" Margin="0,5"/>
                                    <TextBlock Text="• Update task status as you work" FontSize="14" Margin="0,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- Placeholder for other content sections -->
                    <Grid Name="OtherContent" Visibility="Collapsed">
                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Name="ContentTitle" Text="Content Title" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                                <TextBlock Name="ContentDescription" Text="This section will show the selected module content." 
                                           FontSize="16" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
