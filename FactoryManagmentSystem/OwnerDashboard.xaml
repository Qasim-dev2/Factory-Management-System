<Window x:Class="FactoryManagmentSystem.OwnerDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactoryManagmentSystem"
        xmlns:views="clr-namespace:FactoryManagmentSystem.Views"
        mc:Ignorable="d"
        Title="Garments Factory Management System - Owner Dashboard" 
        Height="800" Width="1400" 
        WindowState="Maximized"
        Background="#1E1E2E">
    
    <Window.Resources>
        <!-- Modern Colors -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#2D3142"/>
        <SolidColorBrush x:Key="MainBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        
        <!-- Sidebar Menu Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Margin="10,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Active Sidebar Button Style -->
        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Header Button Style -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Settings Button Style -->
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#6B7280"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        
        <!-- Card Style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E5E7EB" Direction="270" ShadowDepth="4" Opacity="0.5" BlurRadius="12"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Logo Section -->
                <Border Grid.Row="0" Background="#1F2937" Padding="20">
                    <StackPanel>
                        <TextBlock Text="👔" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="Garments Factory" FontSize="16" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Name="WelcomeText" FontSize="12" 
                                   Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <StackPanel>
                        <Button Name="DashboardBtn" Content="📊  Dashboard" Style="{StaticResource ActiveSidebarButton}" 
                                Click="NavigationButton_Click" Tag="Dashboard"/>
                        <Button Name="EmployeesBtn" Content="👥  Employees" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="Employees"/>
                        <Button Name="DepartmentsBtn" Content="🏢  Departments" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="Departments"/>
                        <Button Name="ProductsBtn" Content="📦  Products" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="Products"/>
                        <Button Name="StockBtn" Content="📊  Stock" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="Stock"/>
                        <Button Name="RawMaterialBtn" Content="🧵  Raw Material" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="RawMaterial"/>
                        <Button Name="DealsBtn" Content="🤝  Deals" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="Deals"/>
                        <Button Name="OrderApprovalBtn" Content="✅  Order Approvals" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="OrderApproval"/>
                        <Button Name="TailorTasksBtn" Content="👷  Tailor Tasks" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="TailorTasks"/>
                        <Button Name="RetailersBtn" Content="🏪  Retailers" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="Retailers"/>
                        <Button Name="SalesOrdersBtn" Content="🛒  Sales Orders" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="SalesOrders"/>
                        <Button Name="DeliveriesBtn" Content="📦  Deliveries" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="Deliveries"/>
                        <Button Name="ProductionOrdersBtn" Content="🏭  Production Orders" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="ProductionOrders"/>
                        <Button Name="RevenueBtn" Content="💰  Revenue" Style="{StaticResource SidebarButton}" 
                                Click="NavigationButton_Click" Tag="Revenue"/>
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Bottom Section -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Button Name="SettingsBtn" Content="⚙️  Settings" Style="{StaticResource SettingsButton}" 
                            Click="NavigationButton_Click" Tag="Settings"/>
                    <Button Content="🚪  Logout" Style="{StaticResource HeaderButton}" 
                            Click="LogoutButton_Click" Margin="10,10"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="{StaticResource MainBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Top Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Overview of your factory operations" FontSize="14" 
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="20,0,0,5"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="20" Margin="0,0,20,0" Cursor="Hand"/>
                        <Border Background="#F3F4F6" CornerRadius="20" Padding="10,5">
                            <TextBlock Text="Owner Portal" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Dynamic Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Name="MainContentArea" Margin="30">
                    <!-- Dashboard Content (Default) -->
                    <Grid Name="DashboardContent" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Stats Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Total Revenue" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="$2,847,390" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Orders Today" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="127" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Active Employees" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="89" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="3" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="⚙️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Machine Status" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="95% Up" FontSize="24" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Charts Section -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Production Chart -->
                            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Height="350">
                                <StackPanel>
                                    <TextBlock Text="Monthly Production" FontSize="18" FontWeight="Bold" 
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
                                    
                                    <!-- Simple Bar Chart -->
                                    <Grid Height="250">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Chart Bars -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="5">
                                            <Border Background="{StaticResource AccentBlue}" Height="120" CornerRadius="4"/>
                                            <TextBlock Text="Jan" HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="2.4K" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="5">
                                            <Border Background="{StaticResource AccentBlue}" Height="95" CornerRadius="4"/>
                                            <TextBlock Text="Feb" HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="1.9K" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="5">
                                            <Border Background="{StaticResource AccentBlue}" Height="160" CornerRadius="4"/>
                                            <TextBlock Text="Mar" HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="3.2K" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="5">
                                            <Border Background="{StaticResource AccentBlue}" Height="140" CornerRadius="4"/>
                                            <TextBlock Text="Apr" HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="2.8K" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="5">
                                            <Border Background="{StaticResource AccentBlue}" Height="180" CornerRadius="4"/>
                                            <TextBlock Text="May" HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="3.6K" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Margin="5">
                                            <Border Background="{StaticResource AccentBlue}" Height="200" CornerRadius="4"/>
                                            <TextBlock Text="Jun" HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="4.0K" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Sales Performance Donut Chart -->
                            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Height="350">
                                <StackPanel>
                                    <TextBlock Text="Sales Performance" FontSize="18" FontWeight="Bold" 
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
                                    
                                    <!-- Simple Ring Chart -->
                                    <Grid Height="180" Width="180" HorizontalAlignment="Center">
                                        <!-- Outer Ring - Shirts 45% -->
                                        <Border Background="{StaticResource AccentBlue}" CornerRadius="90" Width="180" Height="180" Opacity="0.8"/>
                                        
                                        <!-- Middle Ring - Pants 30% -->
                                        <Border Background="{StaticResource AccentOrange}" CornerRadius="67.5" Width="135" Height="135" Opacity="0.9"/>
                                        
                                        <!-- Inner Ring - Others 25% -->
                                        <Border Background="#10B981" CornerRadius="45" Width="90" Height="90"/>
                                        
                                        <!-- Center -->
                                        <Border Background="White" CornerRadius="30" Width="60" Height="60">
                                            <TextBlock Text="Sales" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Legend -->
                                    <StackPanel HorizontalAlignment="Center" Margin="0,15,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Rectangle Fill="{StaticResource AccentBlue}" Width="12" Height="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Shirts - 45% ($1.2M)" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Rectangle Fill="{StaticResource AccentOrange}" Width="12" Height="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Pants - 30% ($850K)" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Rectangle Fill="#10B981" Width="12" Height="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Others - 25% ($710K)" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Recent Activity -->
                        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Margin="12,30,12,12">
                            <StackPanel>
                                <TextBlock Text="Recent Activities" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                                <StackPanel>
                                    <TextBlock Text="• New order #1234 received from ABC Corp" FontSize="14" Margin="0,5"/>
                                    <TextBlock Text="• Machine M-101 maintenance completed" FontSize="14" Margin="0,5"/>
                                    <TextBlock Text="• 500 units of Premium Paper shipped" FontSize="14" Margin="0,5"/>
                                    <TextBlock Text="• Employee John Smith clocked in" FontSize="14" Margin="0,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- Employee Management Content -->
                    <Grid Name="EmployeeManagementContent" Visibility="Collapsed">
                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Text="👥 Garments Factory - Employee Management" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Background="#2D2D30" Padding="15" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="✂️ Cutters" Foreground="#3B82F6" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="45 Active" FontSize="12" Foreground="White" Margin="0,5,0,0"/>
                                            <TextBlock Text="Pattern cutting, Fabric preparation" FontSize="10" Foreground="#B0B0B0" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Grid.Column="1" Background="#2D2D30" Padding="15" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Text="🧵 Tailors/Sewers" Foreground="#10B981" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="180 Active" FontSize="12" Foreground="White" Margin="0,5,0,0"/>
                                            <TextBlock Text="Stitching, Assembly, Finishing" FontSize="10" Foreground="#B0B0B0" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Grid.Column="2" Background="#2D2D30" Padding="15" Margin="10,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🔍 Quality Controllers" Foreground="#F59E0B" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="25 Active" FontSize="12" Foreground="White" Margin="0,5,0,0"/>
                                            <TextBlock Text="Inspection, Testing, Approval" FontSize="10" Foreground="#B0B0B0" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                
                                <TextBlock Text="Complete employee management system with roles: Supervisors, Machine Operators, Pressers, Packers, and Administrative Staff." 
                                           FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,20,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Stock Management Content (loaded dynamically) -->
                    <Grid Name="StockContent" Visibility="Collapsed">
                    </Grid>

                    <!-- Placeholder for other content sections -->
                    <Grid Name="OtherContent" Visibility="Collapsed">
                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Name="ContentTitle" Text="Content Title" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                                <TextBlock Name="ContentDescription" Text="This section will show the selected module content." 
                                           FontSize="16" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>