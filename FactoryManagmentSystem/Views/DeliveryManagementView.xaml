<UserControl x:Class="FactoryManagmentSystem.Views.DeliveryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Tab Button Styles -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveTabBtn" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Styles -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Action Button -->
        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="📦 Delivery Management" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Deliveries are auto-generated for Sales Orders and Deals" FontSize="14" Foreground="#64748B" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Name="RefreshBtn" Content="🔄 Refresh" Style="{StaticResource SecondaryBtn}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Statistics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Deliveries -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="TotalDeliveriesText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Total Deliveries" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Pending Deliveries -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="⏳" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="PendingDeliveriesText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Pending" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Delivered -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="DeliveredCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Delivered" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Delivery Persons -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="👷" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="DeliveryPersonsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Delivery Persons" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tab Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Name="ViewAllTab" Content="📋 All Deliveries" Style="{StaticResource ActiveTabBtn}" Tag="ViewAll" Click="TabBtn_Click"/>
            <Button Name="PendingTab" Content="⏳ Pending Only" Style="{StaticResource TabBtn}" Tag="Pending" Click="TabBtn_Click"/>
            <Button Name="UpdateDeliveryTab" Content="✏️ Update Status" Style="{StaticResource TabBtn}" Tag="Update" Click="TabBtn_Click"/>
        </StackPanel>

        <!-- Tab Content Area -->
        <Grid Grid.Row="3">
            <!-- VIEW ALL TAB -->
            <Border Name="ViewAllContent" Background="White" CornerRadius="12" Padding="25" Visibility="Visible">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search and Filter -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <TextBox Name="SearchBox" Height="40" Padding="12,10" FontSize="14" BorderThickness="0" 
                                     Background="Transparent" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Border>

                        <ComboBox Name="StatusFilter" Grid.Column="1" Width="180" Height="40" Margin="15,0" FontSize="14"
                                  SelectionChanged="StatusFilter_SelectionChanged">
                            <ComboBoxItem Content="All Status" IsSelected="True"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Delivered"/>
                        </ComboBox>

                        <ComboBox Name="SourceFilter" Grid.Column="2" Width="180" Height="40" Margin="0,0,15,0" FontSize="14"
                                  SelectionChanged="SourceFilter_SelectionChanged">
                            <ComboBoxItem Content="All Sources" IsSelected="True"/>
                            <ComboBoxItem Content="Sales Order"/>
                            <ComboBoxItem Content="Deal"/>
                        </ComboBox>

                        <Button Grid.Column="3" Content="🔍 Search" Style="{StaticResource PrimaryBtn}" Click="SearchBtn_Click"/>
                    </Grid>

                    <!-- Deliveries DataGrid -->
                    <DataGrid Name="DeliveriesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" RowHeight="50" CanUserAddRows="False"
                              HorizontalGridLinesBrush="#E2E8F0" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#F3E8FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding DeliveryId}" Width="60"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceType}" Width="100"/>
                            <DataGridTextColumn Header="Order/Deal" Binding="{Binding SourceDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Retailer" Binding="{Binding RetailerName}" Width="*"/>
                            <DataGridTextColumn Header="Delivery Date" Binding="{Binding DeliveryDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Delivered By" Binding="{Binding DeliveredByName}" Width="130"/>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,5" CornerRadius="12" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="👁️" Style="{StaticResource SmallActionBtn}" Tag="{Binding DeliveryId}" Click="ViewDelivery_Click" ToolTip="View Details"/>
                                            <Button Content="✅" Style="{StaticResource SmallActionBtn}" Background="#10B981" Tag="{Binding DeliveryId}" Click="MarkDelivered_Click" ToolTip="Mark Delivered"/>
                                            <Button Content="🗑️" Style="{StaticResource SmallActionBtn}" Background="#EF4444" Tag="{Binding DeliveryId}" Click="DeleteDelivery_Click" ToolTip="Delete"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <TextBlock Name="ShowingText" Text="Showing 1-10 of 0 entries" VerticalAlignment="Center" Foreground="#64748B"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="PrevBtn" Content="◀ Previous" Style="{StaticResource SecondaryBtn}" Click="PrevPage_Click" Margin="0,0,10,0"/>
                            <TextBlock Name="PageText" Text="Page 1 of 1" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#475569"/>
                            <Button Name="NextBtn" Content="Next ▶" Style="{StaticResource SecondaryBtn}" Click="NextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- PENDING DELIVERIES TAB -->
            <Border Name="PendingContent" Background="White" CornerRadius="12" Padding="25" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="⏳ Pending Deliveries" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <TextBlock Text="Deliveries awaiting completion - Update their status below" FontSize="14" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- Pending Deliveries DataGrid -->
                    <DataGrid Name="PendingDeliveriesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" RowHeight="50" CanUserAddRows="False"
                              HorizontalGridLinesBrush="#E2E8F0" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FEF3C7"/>
                                <Setter Property="Foreground" Value="#92400E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFBEB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding DeliveryId}" Width="60"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceType}" Width="120"/>
                            <DataGridTextColumn Header="Order/Deal" Binding="{Binding SourceDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Retailer/Customer" Binding="{Binding RetailerName}" Width="*"/>
                            <DataGridTextColumn Header="Delivery Date" Binding="{Binding DeliveryDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                            <DataGridTemplateColumn Header="Quick Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✏️ Update" Style="{StaticResource SmallActionBtn}" Background="#F59E0B" 
                                                    Tag="{Binding DeliveryId}" Click="QuickUpdate_Click" ToolTip="Update Status"/>
                                            <Button Content="✅ Mark Done" Style="{StaticResource SmallActionBtn}" Background="#10B981" 
                                                    Tag="{Binding DeliveryId}" Click="MarkDelivered_Click" ToolTip="Mark as Delivered"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- UPDATE DELIVERY TAB -->
            <Border Name="UpdateDeliveryContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="✏️ Update Delivery Status" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                        <TextBlock Text="Select Delivery to Update *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="UpdateDeliverySelect" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                                  SelectionChanged="UpdateDeliverySelect_Changed">
                            <ComboBoxItem Content="-- Select Delivery --" IsSelected="True"/>
                        </ComboBox>

                        <!-- Delivery Info Panel -->
                        <Border Name="UpdateInfoPanel" Background="#F8FAFC" CornerRadius="8" Padding="20" Margin="0,0,0,20" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Name="UpdateInfoSource" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Retailer:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="UpdateInfoRetailer" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Current Status:" FontWeight="SemiBold" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="UpdateInfoStatus" Text="-"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Delivery Date *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <DatePicker Name="UpdateDeliveryDate" Height="45" Padding="12,10" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Delivered By *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="UpdateDeliveredBy" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="-- Select Person --" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Delivery Address *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateDeliveryAddress" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBox Name="UpdateCity" Height="45" Padding="12,10" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Province" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBox Name="UpdateProvince" Height="45" Padding="12,10" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Postal Code" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBox Name="UpdatePostalCode" Height="45" Padding="12,10" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Receiver Name" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBox Name="UpdateReceiverName" Height="45" Padding="12,10" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Receiver Phone" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateReceiverPhone" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"/>

                        <TextBlock Text="Status *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="UpdateStatus" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20">
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Delivered"/>
                        </ComboBox>

                        <TextBlock Text="Notes" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateNotes" Height="80" Padding="12,10" FontSize="14" Margin="0,0,0,25" TextWrapping="Wrap" AcceptsReturn="True"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Reset" Style="{StaticResource WarningBtn}" Click="ResetUpdateForm_Click" Margin="0,0,15,0"/>
                            <Button Content="💾 Update Delivery" Style="{StaticResource SuccessBtn}" Click="UpdateDeliveryBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
