<UserControl x:Class="FactoryManagmentSystem.Views.ProductionOrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F6FA">

    <UserControl.Resources>
        <!-- Button Styles -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6C7293"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E9F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveTabBtn" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#5F63F2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#5F63F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E51E5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B8B9D4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E8E9F3"/>
            <Setter Property="Foreground" Value="#6C7293"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D2E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#F83245"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E02030"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#5F63F2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- DatePicker Style -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="30,20" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🏭 Production Order Management" 
                               FontSize="24" FontWeight="Bold" Foreground="#2C2C54"/>
                    <TextBlock Text="Manage production orders for products we manufacture" 
                               FontSize="14" Foreground="#6C7293" Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 Refresh" Style="{StaticResource SecondaryBtn}"
                        Click="RefreshBtn_Click" Padding="15,10"/>
            </Grid>
        </Border>

        <!-- Tab Navigation and Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Buttons -->
            <Border Grid.Row="0" Background="#F5F6FA" Padding="30,0,30,0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Height="50">
                    <Button x:Name="BrowseTab" Content="📋 Browse Orders" Tag="Browse"
                            Style="{StaticResource ActiveTabBtn}" Click="TabBtn_Click"/>
                    <Button x:Name="AddTab" Content="➕ Add New Order" Tag="Add"
                            Style="{StaticResource TabBtn}" Click="TabBtn_Click"/>
                    <Button x:Name="UpdateTab" Content="✏️ Update Order" Tag="Update"
                            Style="{StaticResource TabBtn}" Click="TabBtn_Click"/>
                    <Button x:Name="DeleteTab" Content="🗑️ Delete Order" Tag="Delete"
                            Style="{StaticResource TabBtn}" Click="TabBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- Tab Content -->
            <Grid Grid.Row="1">
                <!-- Browse Orders Tab -->
                <ScrollViewer x:Name="BrowseContent" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <Border Padding="30">
                        <StackPanel MaxWidth="1400">
                            <!-- Statistics Cards -->
                            <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Total Orders -->
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalOrdersText" Text="0" FontSize="36" FontWeight="Bold" 
                                               Foreground="#5F63F2" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Text="Total Orders" FontSize="14" Foreground="#6C7293" 
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Pending Orders -->
                            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="5,0,5,0"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PendingOrdersText" Text="0" FontSize="36" FontWeight="Bold" 
                                               Foreground="#FFA726" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Text="Pending" FontSize="14" Foreground="#6C7293" 
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- In Progress -->
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="5,0,5,0"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⚙️" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="InProgressOrdersText" Text="0" FontSize="36" FontWeight="Bold" 
                                               Foreground="#29B6F6" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Text="In Progress" FontSize="14" Foreground="#6C7293" 
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Completed Orders -->
                            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="✅" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CompletedOrdersText" Text="0" FontSize="36" FontWeight="Bold" 
                                               Foreground="#66BB6A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Text="Completed" FontSize="14" Foreground="#6C7293" 
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Search and Filters -->
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Search Bar -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="SearchBox" Grid.Column="0" 
                                             Style="{StaticResource ModernTextBox}"
                                             Text="" TextChanged="SearchBox_TextChanged"
                                             FontSize="14" Height="40">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBlock IsHitTestVisible="False" Text="🔍 Search by Order ID, Product Name, or Category..." 
                                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0" 
                                               Foreground="#999" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Grid.Column="1" Content="Search" Style="{StaticResource PrimaryBtn}"
                                            Margin="10,0,0,0" Padding="20,10" Click="SearchBtn_Click"/>
                                </Grid>

                                <!-- Filters -->
                                <Grid Grid.Row="1" Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="StatusFilter" Style="{StaticResource ModernComboBox}"
                                                  SelectionChanged="StatusFilter_SelectionChanged">
                                            <ComboBoxItem Content="All Status" IsSelected="True"/>
                                            <ComboBoxItem Content="Pending"/>
                                            <ComboBoxItem Content="InProgress"/>
                                            <ComboBoxItem Content="Completed"/>
                                            <ComboBoxItem Content="Cancelled"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                        <TextBlock Text="Priority" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="PriorityFilter" Style="{StaticResource ModernComboBox}"
                                                  SelectionChanged="PriorityFilter_SelectionChanged">
                                            <ComboBoxItem Content="All Priorities" IsSelected="True"/>
                                            <ComboBoxItem Content="Low"/>
                                            <ComboBoxItem Content="Normal"/>
                                            <ComboBoxItem Content="High"/>
                                            <ComboBoxItem Content="Urgent"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="Date Range" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker x:Name="StartDateFilter" Grid.Column="0" 
                                                        Style="{StaticResource ModernDatePicker}"
                                                        SelectedDateChanged="DateFilter_Changed"/>
                                            <TextBlock Grid.Column="1" Text=" - " VerticalAlignment="Center" Margin="5,0"/>
                                            <DatePicker x:Name="EndDateFilter" Grid.Column="2" 
                                                        Style="{StaticResource ModernDatePicker}"
                                                        SelectedDateChanged="DateFilter_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Orders DataGrid -->
                        <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Grid Header -->
                                <Border Grid.Row="0" Background="#F8F9FA" Padding="20,15" 
                                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Production Orders" FontSize="16" FontWeight="SemiBold"/>
                                </Border>

                                <!-- DataGrid -->
                                <DataGrid x:Name="OrdersGrid" Grid.Row="1" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          Background="White"
                                          RowBackground="White"
                                          AlternatingRowBackground="#F8F9FA"
                                          BorderThickness="0"
                                          Margin="20,10">
                                    
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F8F9FA"/>
                                            <Setter Property="Foreground" Value="#2C2C54"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="10"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order ID" Binding="{Binding ProductionOrderID}" Width="80"/>
                                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="200"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                                        <DataGridTextColumn Header="Qty Ordered" Binding="{Binding QuantityOrdered}" Width="100"/>
                                        <DataGridTextColumn Header="Qty Completed" Binding="{Binding QuantityCompleted}" Width="120"/>
                                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100"/>
                                        <DataGridTextColumn Header="Expected End" Binding="{Binding ExpectedEndDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                                        <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" Width="150"/>
                                        
                                        <DataGridTemplateColumn Header="Actions" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="👁️ View" Padding="8,4" Margin="2"
                                                                Background="#29B6F6" Foreground="White" BorderThickness="0"
                                                                Cursor="Hand" Click="ViewOrder_Click" Tag="{Binding ProductionOrderID}">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                        <Button Content="✏️ Edit" Padding="8,4" Margin="2"
                                                                Background="#66BB6A" Foreground="White" BorderThickness="0"
                                                                Cursor="Hand" Click="EditOrder_Click" Tag="{Binding ProductionOrderID}">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                        <Button Content="🗑️" Padding="8,4" Margin="2"
                                                                Background="#F83245" Foreground="White" BorderThickness="0"
                                                                Cursor="Hand" Click="DeleteOrderQuick_Click" Tag="{Binding ProductionOrderID}">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Pagination -->
                                <Border Grid.Row="2" Background="#F8F9FA" Padding="20,15" 
                                        BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="ShowingText" Grid.Column="0" Text="Showing 1-10 of 50 entries" 
                                                   VerticalAlignment="Center" Foreground="#6C7293"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="PrevBtn" Content="◀ Previous" Style="{StaticResource SecondaryBtn}"
                                                    Padding="15,8" Margin="0,0,10,0" Click="PrevPage_Click"/>
                                            <TextBlock x:Name="PageText" Text="Page 1 of 5" 
                                                       VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                                            <Button x:Name="NextBtn" Content="Next ▶" Style="{StaticResource SecondaryBtn}"
                                                    Padding="15,8" Click="NextPage_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Add New Order Tab -->
                <ScrollViewer x:Name="AddContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Border Padding="30">
                        <StackPanel MaxWidth="900">
                        <Border Background="White" CornerRadius="12" Padding="30" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="➕ Create New Production Order" FontSize="20" FontWeight="Bold" 
                                           Foreground="#2C2C54" Margin="0,0,0,20"/>

                                <!-- Product Selection -->
                                <TextBlock Text="Product *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="AddProductCombo" Style="{StaticResource ModernComboBox}" 
                                          Margin="0,0,0,15" SelectionChanged="AddProductCombo_SelectionChanged">
                                    <ComboBoxItem Content="Select Product" IsSelected="True"/>
                                </ComboBox>

                                <!-- Quantity -->
                                <TextBlock Text="Quantity to Produce *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="AddQuantityText" Style="{StaticResource ModernTextBox}" 
                                         Text="1" Margin="0,0,0,15"
                                         LostFocus="AddQuantityText_LostFocus"/>

                                <!-- Dates Row -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start Date" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <DatePicker x:Name="AddStartDate" Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Expected End Date" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <DatePicker x:Name="AddExpectedEndDate" Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Priority and Created By Row -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Priority" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="AddPriorityCombo" Style="{StaticResource ModernComboBox}">
                                            <ComboBoxItem Content="Low"/>
                                            <ComboBoxItem Content="Normal" IsSelected="True"/>
                                            <ComboBoxItem Content="High"/>
                                            <ComboBoxItem Content="Urgent"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Created By (Tailor)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="AddCreatedByCombo" Style="{StaticResource ModernComboBox}">
                                            <ComboBoxItem Content="Select Tailor"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Notes -->
                                <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="AddNotesText" Style="{StaticResource ModernTextBox}" 
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,20"/>

                                <!-- Material Requirements Section (Inline) -->
                                <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="2" 
                                        CornerRadius="10" Padding="20" Margin="0,0,0,20"
                                        x:Name="MaterialRequirementsPanel" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="📋 Material Requirements" FontSize="18" FontWeight="Bold" 
                                                   Foreground="#2C2C54" Margin="0,0,0,15"/>
                                        
                                        <TextBlock x:Name="MaterialRequirementsTitle" 
                                                   FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="#555555" Margin="0,0,0,10"/>
                                        
                                        <!-- Materials DataGrid -->
                                        <DataGrid x:Name="MaterialRequirementsGrid" 
                                                  AutoGenerateColumns="False" 
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="None"
                                                  Background="White"
                                                  RowBackground="White"
                                                  AlternatingRowBackground="#F9F9F9"
                                                  BorderBrush="#D0D0D0"
                                                  BorderThickness="1"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  SelectionMode="Single"
                                                  Height="200"
                                                  Margin="0,0,0,15">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*" MinWidth="150">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Padding" Value="8"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Per Unit" Binding="{Binding QuantityPerUnitFormatted}" Width="120">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Padding" Value="8"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Total Required" Binding="{Binding TotalQuantityRequiredFormatted}" Width="130">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Padding" Value="8"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Available" Binding="{Binding AvailableStockFormatted}" Width="120">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Padding" Value="8"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Status" Binding="{Binding StockStatus}" Width="110">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Padding" Value="8"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="Sufficient">
                                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                                </Trigger>
                                                                <Trigger Property="Text" Value="Insufficient">
                                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Cost" Binding="{Binding TotalMaterialCostFormatted}" Width="110">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Padding" Value="8"/>
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        
                                        <!-- Total Cost -->
                                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" 
                                                CornerRadius="5" Padding="15" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Total Material Cost: " FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TotalMaterialCostText" Text="Rs. 0.00" 
                                                           FontSize="16" FontWeight="Bold" Foreground="#E67E22" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Reset Form" Style="{StaticResource SecondaryBtn}" 
                                            Margin="0,0,10,0" Click="ResetAddForm_Click"/>
                                    <Button Content="Create Production Order" Style="{StaticResource PrimaryBtn}" 
                                            Click="CreateOrder_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Update Order Tab -->
                <ScrollViewer x:Name="UpdateContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Border Padding="30">
                        <StackPanel MaxWidth="900">
                        <Border Background="White" CornerRadius="12" Padding="30" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="✏️ Update Production Order" FontSize="20" FontWeight="Bold" 
                                           Foreground="#2C2C54" Margin="0,0,0,20"/>

                                <!-- Select Order to Update -->
                                <TextBlock Text="Select Order *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="UpdateOrderCombo" Style="{StaticResource ModernComboBox}" 
                                          Margin="0,0,0,20" SelectionChanged="UpdateOrderCombo_SelectionChanged">
                                    <ComboBoxItem Content="Select Production Order" IsSelected="True"/>
                                </ComboBox>

                                <!-- Update Form (Hidden until order selected) -->
                                <StackPanel x:Name="UpdateFormPanel" Visibility="Collapsed">
                                    <!-- Product (Read-only) -->
                                    <TextBlock Text="Product" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="UpdateProductText" Style="{StaticResource ModernTextBox}" 
                                             IsReadOnly="True" Background="#F5F6FA" Margin="0,0,0,15"/>

                                    <!-- Quantities Row -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Quantity Ordered *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBox x:Name="UpdateQuantityOrderedText" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Quantity Completed" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBox x:Name="UpdateQuantityCompletedText" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Dates Row -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Start Date" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <DatePicker x:Name="UpdateStartDate" Style="{StaticResource ModernDatePicker}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Expected End" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <DatePicker x:Name="UpdateExpectedEndDate" Style="{StaticResource ModernDatePicker}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Actual End" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <DatePicker x:Name="UpdateActualEndDate" Style="{StaticResource ModernDatePicker}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Status, Priority, Created By Row -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Status *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="UpdateStatusCombo" Style="{StaticResource ModernComboBox}">
                                                <ComboBoxItem Content="Pending"/>
                                                <ComboBoxItem Content="InProgress"/>
                                                <ComboBoxItem Content="Completed"/>
                                                <ComboBoxItem Content="Cancelled"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Priority" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="UpdatePriorityCombo" Style="{StaticResource ModernComboBox}">
                                                <ComboBoxItem Content="Low"/>
                                                <ComboBoxItem Content="Normal"/>
                                                <ComboBoxItem Content="High"/>
                                                <ComboBoxItem Content="Urgent"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Created By" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="UpdateCreatedByCombo" Style="{StaticResource ModernComboBox}">
                                                <ComboBoxItem Content="Select Tailor"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Notes -->
                                    <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="UpdateNotesText" Style="{StaticResource ModernTextBox}" 
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,20"/>

                                    <!-- Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Reset Form" Style="{StaticResource SecondaryBtn}" 
                                                Margin="0,0,10,0" Click="ResetUpdateForm_Click"/>
                                        <Button Content="Update Order" Style="{StaticResource PrimaryBtn}" 
                                                Click="UpdateOrder_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Delete Order Tab -->
                <ScrollViewer x:Name="DeleteContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Border Padding="30">
                        <StackPanel MaxWidth="700">
                        <Border Background="White" CornerRadius="12" Padding="30" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🗑️ Delete Production Order" FontSize="20" FontWeight="Bold" 
                                           Foreground="#2C2C54" Margin="0,0,0,10"/>
                                <TextBlock Text="⚠️ Warning: This action cannot be undone!" 
                                           FontSize="14" Foreground="#F83245" Margin="0,0,0,20"/>

                                <!-- Select Order to Delete -->
                                <TextBlock Text="Select Order to Delete *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DeleteOrderCombo" Style="{StaticResource ModernComboBox}" 
                                          Margin="0,0,0,20" SelectionChanged="DeleteOrderCombo_SelectionChanged">
                                    <ComboBoxItem Content="Select Production Order" IsSelected="True"/>
                                </ComboBox>

                                <!-- Order Details (Hidden until order selected) -->
                                <Border x:Name="DeleteOrderDetails" Visibility="Collapsed" 
                                        Background="#FFF3E0" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Order Details:" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="DeleteOrderIdText" Text="Order ID: -" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="DeleteProductText" Text="Product: -" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="DeleteQuantityText" Text="Quantity: -" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="DeleteStatusText" Text="Status: -" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="DeleteCreatedByText" Text="Created By: -"/>
                                    </StackPanel>
                                </Border>

                                <!-- Delete Button -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource SecondaryBtn}" 
                                            Margin="0,0,10,0" Click="ResetDeleteForm_Click"/>
                                    <Button x:Name="ConfirmDeleteBtn" Content="Confirm Delete" 
                                            Style="{StaticResource DangerBtn}" 
                                            IsEnabled="False" Click="ConfirmDelete_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
