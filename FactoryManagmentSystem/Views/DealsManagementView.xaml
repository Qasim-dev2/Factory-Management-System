<UserControl x:Class="FactoryManagmentSystem.Views.DealsManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:FactoryManagmentSystem.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Converter for enabling/disabling buttons based on deal status -->
        <local:DealStatusToEditableConverter x:Key="DealStatusToEditableConverter"/>
        
        <!-- Tab Button Styles -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveTabBtn" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Styles -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Action Button -->
        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="📋 Special Deals Management" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Manage special orders and deals outside of regular retailers" FontSize="14" Foreground="#64748B" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Name="RefreshBtn" Content="🔄 Refresh" Style="{StaticResource PrimaryBtn}" Click="RefreshBtn_Click" Margin="0,0,10,0"/>
                <Button Name="AddDealBtn" Content="➕ Add New Deal" Style="{StaticResource SuccessBtn}" Click="AddDealBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Statistics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Deals -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="TotalDealsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Total Deals" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Pending Deals -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="⏳" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="PendingDealsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Pending" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- In Progress -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔄" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="InProgressDealsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="In Progress" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Completed -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="CompletedDealsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Completed" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Delivered -->
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🚚" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="DeliveredDealsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#0EA5E9" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Delivered" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Cancelled -->
            <Border Grid.Column="5" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="❌" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="CancelledDealsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Cancelled" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tab Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Name="ViewAllTab" Content="📋 View All Deals" Style="{StaticResource ActiveTabBtn}" Tag="ViewAll" Click="TabBtn_Click"/>
            <Button Name="AddDealTab" Content="➕ Add Deal" Style="{StaticResource TabBtn}" Tag="Add" Click="TabBtn_Click"/>
            <Button Name="UpdateDealTab" Content="✏️ Update Deal" Style="{StaticResource TabBtn}" Tag="Update" Click="TabBtn_Click"/>
            <Button Name="DeleteDealTab" Content="🗑️ Delete Deal" Style="{StaticResource TabBtn}" Tag="Delete" Click="TabBtn_Click"/>
        </StackPanel>

        <!-- Tab Content Area -->
        <Grid Grid.Row="3">
            <!-- VIEW ALL TAB -->
            <Border Name="ViewAllContent" Background="White" CornerRadius="12" Padding="25" Visibility="Visible">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Deal Catalog Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="📋 Deal Catalog" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                        
                        <!-- Search and Filter -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="45">
                                <Grid>
                                    <TextBlock Name="SearchPlaceholder" Text="🔍 Search by deal name, client, or ID..." 
                                               Foreground="#94A3B8" FontSize="14" 
                                               IsHitTestVisible="False" 
                                               VerticalAlignment="Center" 
                                               Margin="15,0,0,0"/>
                                    <TextBox Name="SearchBox" Background="Transparent" BorderThickness="0" 
                                             Padding="15,10" FontSize="14"
                                             TextChanged="SearchBox_TextChanged"
                                             GotFocus="SearchBox_GotFocus"
                                             LostFocus="SearchBox_LostFocus"/>
                                </Grid>
                            </Border>

                            <ComboBox Name="StatusFilter" Grid.Column="1" Width="180" Height="45" Margin="15,0" FontSize="14"
                                      SelectionChanged="StatusFilter_SelectionChanged">
                                <ComboBoxItem Content="All Status" IsSelected="True"/>
                                <ComboBoxItem Content="Pending"/>
                                <ComboBoxItem Content="In Progress"/>
                                <ComboBoxItem Content="Completed"/>
                                <ComboBoxItem Content="Delivered"/>
                                <ComboBoxItem Content="Cancelled"/>
                            </ComboBox>

                            <Button Grid.Column="2" Content="🔍 Search" Height="45" Width="120" Style="{StaticResource PrimaryBtn}" Click="SearchBtn_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Deals DataGrid -->
                    <DataGrid Name="DealsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" RowHeight="50" CanUserAddRows="False"
                              HorizontalGridLinesBrush="#E2E8F0" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Deal ID" Binding="{Binding DealId}" Width="80"/>
                            <DataGridTextColumn Header="Deal Name" Binding="{Binding DealName}" Width="*"/>
                            <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="150"/>
                            <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" Width="130"/>
                            <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, StringFormat='{}{0:dd MMM yyyy}'}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" CornerRadius="12" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="In Progress">
                                                            <Setter Property="Background" Value="#E0E7FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                            <Setter Property="Background" Value="#E0F2FE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="In Progress">
                                                                <Setter Property="Foreground" Value="#4F46E5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                                <Setter Property="Foreground" Value="#0EA5E9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="👁️" Style="{StaticResource SmallActionBtn}" Tag="{Binding DealId}" Click="ViewDeal_Click" ToolTip="View Details"/>
                                            <Button Name="EditBtn" Content="✏️" Tag="{Binding DealId}" Click="EditDeal_Click">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource DealStatusToEditableConverter}">
                                                        <Binding Path="Status"/>
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallActionBtn}">
                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                        <Setter Property="ToolTip" Value="Edit Deal"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                                <Setter Property="ToolTip" Value="Cannot edit - Deal is approved or in progress"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Name="DeleteBtn" Content="🗑️" Tag="{Binding DealId}" Click="DeleteDeal_Click">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource DealStatusToEditableConverter}">
                                                        <Binding Path="Status"/>
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallActionBtn}">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Setter Property="ToolTip" Value="Delete Deal"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                                <Setter Property="ToolTip" Value="Cannot delete - Deal is approved or in progress"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <TextBlock Name="ShowingText" Text="Showing 1-10 of 0 entries" VerticalAlignment="Center" Foreground="#64748B"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="PrevBtn" Content="◀ Previous" Style="{StaticResource PrimaryBtn}" Click="PrevPage_Click" Margin="0,0,10,0"/>
                            <TextBlock Name="PageText" Text="Page 1 of 1" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#475569"/>
                            <Button Name="NextBtn" Content="Next ▶" Style="{StaticResource PrimaryBtn}" Click="NextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ADD DEAL TAB -->
            <Border Name="AddDealContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="➕ Add New Special Deal" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                        <TextBlock Text="Deal Name *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="AddDealName" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Requested By (Client/Company Name) *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="AddRequestedBy" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>
                        
                        <TextBlock Text="Deal Type" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="AddDealType" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20">
                            <ComboBoxItem Content="-- Select Type --" IsSelected="True"/>
                            <ComboBoxItem Content="Bulk Order"/>
                            <ComboBoxItem Content="Custom Design"/>
                            <ComboBoxItem Content="Wholesale"/>
                            <ComboBoxItem Content="Corporate"/>
                            <ComboBoxItem Content="Retail"/>
                        </ComboBox>

                        <TextBlock Text="Contact Person" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="AddContactPerson" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Email" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="AddEmail" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Phone" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="AddPhone" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Delivery Address" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="AddDeliveryAddress" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="City" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="AddCity" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Province" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="AddProvince" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20">
                            <ComboBoxItem Content="-- Select Province --" IsSelected="True"/>
                            <ComboBoxItem Content="Punjab"/>
                            <ComboBoxItem Content="Sindh"/>
                            <ComboBoxItem Content="KPK"/>
                            <ComboBoxItem Content="Balochistan"/>
                            <ComboBoxItem Content="Gilgit-Baltistan"/>
                            <ComboBoxItem Content="AJK"/>
                        </ComboBox>

                        <TextBlock Text="Created By (Employee) *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="AddCreatedBy" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20">
                            <ComboBoxItem Content="-- Select Employee --" IsSelected="True"/>
                            <ComboBoxItem Content="Created by Owner"/>
                        </ComboBox>

                        <TextBlock Text="Deadline *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <DatePicker Name="AddDeadline" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"/>

                        <TextBlock Text="Description (Optional)" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="AddDescription" Height="100" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" 
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,25" Background="White"/>

                        <!-- Deal Items Section -->
                        <TextBlock Text="📦 Deal Items (Products)" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,10,0,15"/>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Name="AddDealItemProduct" Grid.Column="0" Height="40" Padding="10" FontSize="13">
                                <ComboBoxItem Content="-- Select Product --" IsSelected="True"/>
                            </ComboBox>

                            <TextBox Name="AddDealItemQuantity" Grid.Column="2" Height="40" Padding="10" FontSize="13" 
                                     BorderBrush="#E2E8F0" BorderThickness="1" Background="White" Text="1"/>

                            <TextBox Name="AddDealItemPrice" Grid.Column="4" Height="40" Padding="10" FontSize="13" 
                                     BorderBrush="#E2E8F0" BorderThickness="1" Background="White" Text="0"/>

                            <Button Name="AddDealItemBtn" Grid.Column="6" Content="➕ Add" Style="{StaticResource PrimaryBtn}" 
                                    Padding="15,8" Click="AddDealItemBtn_Click"/>
                        </Grid>

                        <TextBlock Text="Product" FontSize="11" Foreground="#64748B" Margin="0,0,0,5" Grid.Column="0"/>
                        <TextBlock Text="Quantity" FontSize="11" Foreground="#64748B" Margin="215,0,0,-20" Grid.Column="2"/>
                        <TextBlock Text="Unit Price (Rs.)" FontSize="11" Foreground="#64748B" Margin="345,0,0,-20" Grid.Column="4"/>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" MaxHeight="200">
                            <DataGrid Name="DealItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column" RowHeight="40" CanUserAddRows="False"
                                      HorizontalGridLinesBrush="#E2E8F0">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="100"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat='{}{0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat='{}{0:N2}'}" Width="100"/>
                                    <DataGridTemplateColumn Header="Action" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️" FontSize="12" Padding="5" Background="#EF4444" Foreground="White" 
                                                        BorderThickness="0" Cursor="Hand" Click="RemoveDealItem_Click" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Clear Form" Style="{StaticResource WarningBtn}" Click="ClearAddForm_Click" Margin="0,0,15,0"/>
                            <Button Content="💾 Save Deal" Style="{StaticResource SuccessBtn}" Click="SaveDeal_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- UPDATE DEAL TAB -->
            <Border Name="UpdateDealContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="✏️ Update Deal" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                        <TextBlock Text="Select Deal to Update *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="UpdateDealSelect" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                                  SelectionChanged="UpdateDealSelect_Changed">
                            <ComboBoxItem Content="-- Select Deal --" IsSelected="True"/>
                        </ComboBox>

                        <TextBlock Text="Deal Name *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateDealName" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" 
                                 BorderThickness="1" Background="White" Margin="0,0,0,20"/>

                        <TextBlock Text="Requested By *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateRequestedBy" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" 
                                 BorderThickness="1" Background="White" Margin="0,0,0,20"/>

                        <TextBlock Text="Deal Type" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="UpdateDealType" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20">
                            <ComboBoxItem Content="-- Select Type --" IsSelected="True"/>
                            <ComboBoxItem Content="Bulk Order"/>
                            <ComboBoxItem Content="Custom Design"/>
                            <ComboBoxItem Content="Wholesale"/>
                            <ComboBoxItem Content="Corporate"/>
                            <ComboBoxItem Content="Retail"/>
                        </ComboBox>

                        <TextBlock Text="Contact Person" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateContactPerson" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Email" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateEmail" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Phone" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdatePhone" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Delivery Address" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateDeliveryAddress" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="City" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <TextBox Name="UpdateCity" Height="45" Padding="12" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="White"/>

                        <TextBlock Text="Province" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="UpdateProvince" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20">
                            <ComboBoxItem Content="-- Select Province --" IsSelected="True"/>
                            <ComboBoxItem Content="Punjab"/>
                            <ComboBoxItem Content="Sindh"/>
                            <ComboBoxItem Content="KPK"/>
                            <ComboBoxItem Content="Balochistan"/>
                            <ComboBoxItem Content="Gilgit-Baltistan"/>
                            <ComboBoxItem Content="AJK"/>
                        </ComboBox>

                        <TextBlock Text="Deadline *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <DatePicker Name="UpdateDeadline" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"/>

                        <TextBlock Text="Status *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="UpdateStatus" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,25">
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="In Progress"/>
                            <ComboBoxItem Content="Completed"/>
                            <ComboBoxItem Content="Delivered"/>
                            <ComboBoxItem Content="Cancelled"/>
                        </ComboBox>

                        <!-- Deal Items Section -->
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="📦 Deal Items" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                                <!-- Add Item Controls -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Product *" FontSize="12" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/>
                                        <ComboBox Name="UpdateDealItemProduct" Height="40" Padding="10" FontSize="13"
                                                  SelectionChanged="UpdateDealItemProduct_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quantity *" FontSize="12" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/>
                                        <TextBox Name="UpdateDealItemQuantity" Height="40" Padding="10" FontSize="13" Background="White"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Unit Price *" FontSize="12" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/>
                                        <TextBox Name="UpdateDealItemPrice" Height="40" Padding="10" FontSize="13" Background="White"/>
                                    </StackPanel>

                                    <Button Grid.Column="6" Content="➕ Add Item" Height="40" Margin="0,20,0,0"
                                            Style="{StaticResource PrimaryBtn}" Click="UpdateAddDealItemBtn_Click"/>
                                </Grid>

                                <!-- Items DataGrid -->
                                <DataGrid Name="UpdateDealItemsGrid" AutoGenerateColumns="False" Height="200" 
                                          CanUserAddRows="False" HeadersVisibility="Column" 
                                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E2E8F0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="0.7*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='{}{0:N2}'}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat='{}{0:N2}'}" Width="*" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Action" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️" Padding="8,4" FontSize="12" Background="#FEE2E2" 
                                                            Foreground="#DC2626" BorderBrush="#FCA5A5" Click="UpdateRemoveDealItem_Click"
                                                            Tag="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Reset" Style="{StaticResource WarningBtn}" Click="ResetUpdateForm_Click" Margin="0,0,15,0"/>
                            <Button Content="💾 Update Deal" Style="{StaticResource SuccessBtn}" Click="UpdateDealBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DELETE DEAL TAB -->
            <Border Name="DeleteDealContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel MaxWidth="600">
                    <TextBlock Text="🗑️ Delete Deal" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                    <Border Background="#FEF2F2" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Warning: Deleting a deal is permanent and cannot be undone. Please select the deal carefully." 
                                       Foreground="#DC2626" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Select Deal to Delete *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                    <ComboBox Name="DeleteDealSelect" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                              SelectionChanged="DeleteDealSelect_Changed">
                        <ComboBoxItem Content="-- Select Deal --" IsSelected="True"/>
                    </ComboBox>

                    <!-- Deal Preview -->
                    <Border Name="DeletePreviewPanel" Background="#F8FAFC" CornerRadius="8" Padding="20" Margin="0,0,0,25" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Deal Preview" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Deal Name:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Name="DeletePreviewName" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Requested By:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="DeletePreviewRequested" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Deadline:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="DeletePreviewDeadline" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Name="DeletePreviewStatus" Text="-"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="🗑️ Delete Selected Deal" Style="{StaticResource DangerBtn}" Click="ConfirmDeleteDeal_Click" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
