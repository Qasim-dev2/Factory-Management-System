<UserControl x:Class="FactoryManagmentSystem.Views.RevenueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#f5f5f5">

    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.15" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Success Button -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Warning Button -->
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF9800"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F57C00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Background="#1565C0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="💰 Revenue Management" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Monthly Income, Expenses &amp; Profit Tracking" FontSize="14" Foreground="#B3E5FC" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <!-- Year Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Year:" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbYear" Width="100" FontSize="14" SelectionChanged="cmbYear_SelectionChanged"/>
                        <Button Content="🔄 Refresh" Style="{StaticResource PrimaryButton}" 
                                Background="#0288D1" Click="RefreshButton_Click" Margin="15,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Yearly Summary Cards -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Total Income -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📈 TOTAL INCOME" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtTotalIncome" Text="Rs. 0" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtIncomeBreakdown" Text="Sales: Rs.0 | Deals: Rs.0" FontSize="11" Foreground="#888" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Expenses -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📉 TOTAL EXPENSES" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtTotalExpense" Text="Rs. 0" FontSize="24" FontWeight="Bold" Foreground="#F44336" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtExpenseBreakdown" Text="Salaries | Raw Mat | Misc" FontSize="11" Foreground="#888" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- Net Profit -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="💵 NET PROFIT" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtNetProfit" Text="Rs. 0" FontSize="24" FontWeight="Bold" Foreground="#2196F3" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtProfitPercent" Text="Margin: 0%" FontSize="11" Foreground="#888" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Months with Data -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📅 MONTHS RECORDED" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtMonthsCount" Text="0 / 12" FontSize="24" FontWeight="Bold" Foreground="#9C27B0" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtCurrentMonth" Text="Current: January" FontSize="11" Foreground="#888" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions Panel -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="5,10,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Month Selector -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Select Month:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbMonth" Width="150" FontSize="14" SelectionChanged="cmbMonth_SelectionChanged">
                            <ComboBoxItem Content="January" Tag="1"/>
                            <ComboBoxItem Content="February" Tag="2"/>
                            <ComboBoxItem Content="March" Tag="3"/>
                            <ComboBoxItem Content="April" Tag="4"/>
                            <ComboBoxItem Content="May" Tag="5"/>
                            <ComboBoxItem Content="June" Tag="6"/>
                            <ComboBoxItem Content="July" Tag="7"/>
                            <ComboBoxItem Content="August" Tag="8"/>
                            <ComboBoxItem Content="September" Tag="9"/>
                            <ComboBoxItem Content="October" Tag="10"/>
                            <ComboBoxItem Content="November" Tag="11"/>
                            <ComboBoxItem Content="December" Tag="12"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnPaySalaries" Content="💳 Pay Salaries" 
                                Style="{StaticResource SuccessButton}" Click="PaySalaries_Click"/>
                        <Button Content="➕ Add Expense" Style="{StaticResource WarningButton}" Click="AddExpense_Click"/>
                        <Button Content="🔄 Calculate Month" Style="{StaticResource PrimaryButton}" Click="CalculateMonth_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Selected Month Details -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="5,10,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Income Column -->
                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="📥 INCOME" FontSize="14" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,10"/>
                        <Border Background="#E8F5E9" CornerRadius="5" Padding="15">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Sales Orders:" FontSize="13"/>
                                    <TextBlock x:Name="txtMonthSales" Text="Rs. 0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Deal Orders:" FontSize="13"/>
                                    <TextBlock x:Name="txtMonthDeals" Text="Rs. 0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Separator Margin="0,10"/>
                                <Grid>
                                    <TextBlock Text="Total Income:" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtMonthTotalIncome" Text="Rs. 0" FontSize="14" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Expenses Column -->
                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Text="📤 EXPENSES" FontSize="14" FontWeight="Bold" Foreground="#F44336" Margin="0,0,0,10"/>
                        <Border Background="#FFEBEE" CornerRadius="5" Padding="15">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Salaries:" FontSize="13"/>
                                    <TextBlock x:Name="txtMonthSalaries" Text="Rs. 0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Raw Materials:" FontSize="13"/>
                                    <TextBlock x:Name="txtMonthRawMaterial" Text="Rs. 0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Miscellaneous:" FontSize="13"/>
                                    <TextBlock x:Name="txtMonthMisc" Text="Rs. 0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Separator Margin="0,10"/>
                                <Grid>
                                    <TextBlock Text="Total Expense:" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtMonthTotalExpense" Text="Rs. 0" FontSize="14" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Summary Column -->
                    <StackPanel Grid.Column="2" Margin="10">
                        <TextBlock Text="📊 SUMMARY" FontSize="14" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,10"/>
                        <Border Background="#E3F2FD" CornerRadius="5" Padding="15">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Salary Status:" FontSize="13"/>
                                    <TextBlock x:Name="txtSalaryStatus" Text="⏳ Pending" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Month:" FontSize="13"/>
                                    <TextBlock x:Name="txtSelectedMonth" Text="January 2025" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Separator Margin="0,10"/>
                                <Grid>
                                    <TextBlock Text="Net Profit:" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtMonthProfit" Text="Rs. 0" FontSize="14" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock x:Name="txtMonthNotes" Text="" FontSize="11" Foreground="#666" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Monthly Data Grid -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="5,10,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="📋 Monthly Revenue Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <DataGrid x:Name="dgMonthlyRevenue" Grid.Row="1"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="White"
                              BorderThickness="1"
                              BorderBrush="#E0E0E0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionChanged="dgMonthlyRevenue_SelectionChanged"
                              RowHeight="40"
                              ColumnHeaderHeight="45">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Month" Binding="{Binding MonthName}" Width="100"/>
                            <DataGridTextColumn Header="Sales Income" Binding="{Binding SalesIncome, StringFormat=Rs. {0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="Deal Income" Binding="{Binding DealIncome, StringFormat=Rs. {0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="Total Income" Binding="{Binding TotalIncome, StringFormat=Rs. {0:N0}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Salaries" Binding="{Binding TotalSalaries, StringFormat=Rs. {0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="Salary Status" Binding="{Binding SalaryStatus}" Width="90"/>
                            <DataGridTextColumn Header="Raw Material" Binding="{Binding RawMaterialCost, StringFormat=Rs. {0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="Misc" Binding="{Binding MiscExpense, StringFormat=Rs. {0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="Total Expense" Binding="{Binding TotalExpense, StringFormat=Rs. {0:N0}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F44336"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Net Profit" Binding="{Binding NetProfit, StringFormat=Rs. {0:N0}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProfitStatus}" Value="Profit">
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProfitStatus}" Value="Loss">
                                                <Setter Property="Foreground" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
