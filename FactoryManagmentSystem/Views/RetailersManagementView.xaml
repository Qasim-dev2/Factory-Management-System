<UserControl x:Class="FactoryManagmentSystem.Views.RetailersManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Tab Button Styles -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveTabBtn" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Styles -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Action Button -->
        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="🏪 Retailers Management" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Manage your retail partners and distributors" FontSize="14" Foreground="#64748B" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Name="RefreshBtn" Content="🔄 Refresh" Style="{StaticResource SecondaryBtn}" Click="RefreshBtn_Click" Margin="0,0,10,0"/>
                <Button Name="AddRetailerBtn" Content="➕ Add New Retailer" Style="{StaticResource PrimaryBtn}" Click="AddRetailerBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Statistics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Retailers -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🏪" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="TotalRetailersText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Total Retailers" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Active Retailers -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="ActiveRetailersText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Active" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Inactive Retailers -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="⏸️" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="InactiveRetailersText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Inactive" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Cities Covered -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🏙️" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="CitiesCoveredText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Cities Covered" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tab Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Name="ViewAllTab" Content="📋 View All Retailers" Style="{StaticResource ActiveTabBtn}" Tag="ViewAll" Click="TabBtn_Click"/>
            <Button Name="AddRetailerTab" Content="➕ Add Retailer" Style="{StaticResource TabBtn}" Tag="Add" Click="TabBtn_Click"/>
            <Button Name="UpdateRetailerTab" Content="✏️ Update Retailer" Style="{StaticResource TabBtn}" Tag="Update" Click="TabBtn_Click"/>
            <Button Name="DeleteRetailerTab" Content="🗑️ Delete Retailer" Style="{StaticResource TabBtn}" Tag="Delete" Click="TabBtn_Click"/>
        </StackPanel>

        <!-- Tab Content Area -->
        <Grid Grid.Row="3">
            <!-- VIEW ALL TAB -->
            <Border Name="ViewAllContent" Background="White" CornerRadius="12" Padding="25" Visibility="Visible">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search and Filter -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Name="SearchBox" Grid.Column="0" Height="40" Padding="12,10" FontSize="14"
                                 Text="" BorderBrush="#E2E8F0" BorderThickness="1"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <ComboBox Name="CityFilter" Grid.Column="1" Width="160" Height="40" Margin="15,0" FontSize="14"
                                  SelectionChanged="CityFilter_SelectionChanged">
                            <ComboBoxItem Content="All Cities" IsSelected="True"/>
                            <ComboBoxItem Content="Karachi"/>
                            <ComboBoxItem Content="Lahore"/>
                            <ComboBoxItem Content="Islamabad"/>
                            <ComboBoxItem Content="Faisalabad"/>
                            <ComboBoxItem Content="Rawalpindi"/>
                            <ComboBoxItem Content="Multan"/>
                            <ComboBoxItem Content="Peshawar"/>
                        </ComboBox>

                        <Button Grid.Column="2" Content="🔍 Search" Style="{StaticResource PrimaryBtn}" Click="SearchBtn_Click"/>
                    </Grid>

                    <!-- Retailers DataGrid -->
                    <DataGrid Name="RetailersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" RowHeight="50" CanUserAddRows="False"
                              HorizontalGridLinesBrush="#E2E8F0" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#ECFDF5"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding RetailerId}" Width="60"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Contact Name" Binding="{Binding ContactName}" Width="150"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" CornerRadius="12" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="👁️" Style="{StaticResource SmallActionBtn}" Tag="{Binding RetailerId}" Click="ViewRetailer_Click" ToolTip="View Details"/>
                                            <Button Content="✏️" Style="{StaticResource SmallActionBtn}" Background="#F59E0B" Tag="{Binding RetailerId}" Click="EditRetailer_Click" ToolTip="Edit"/>
                                            <Button Content="🗑️" Style="{StaticResource SmallActionBtn}" Background="#EF4444" Tag="{Binding RetailerId}" Click="DeleteRetailer_Click" ToolTip="Delete"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <TextBlock Name="ShowingText" Text="Showing 1-10 of 0 entries" VerticalAlignment="Center" Foreground="#64748B"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="PrevBtn" Content="◀ Previous" Style="{StaticResource SecondaryBtn}" Click="PrevPage_Click" Margin="0,0,10,0"/>
                            <TextBlock Name="PageText" Text="Page 1 of 1" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#475569"/>
                            <Button Name="NextBtn" Content="Next ▶" Style="{StaticResource SecondaryBtn}" Click="NextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ADD RETAILER TAB -->
            <Border Name="AddRetailerContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="700">
                        <TextBlock Text="➕ Add New Retailer" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                        <!-- Error Message Display -->
                        <Border Name="AddErrorBorder" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Name="AddErrorMessage" Text="" Foreground="#DC2626" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Retailer/Company Name *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <TextBox Name="AddName" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Contact Name *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <TextBox Name="AddContactName" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Phone *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <TextBox Name="AddPhone" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Alternative Phone" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <TextBox Name="AddAltPhone" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Email" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <TextBox Name="AddEmail" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="AddCity" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="-- Select City --" IsSelected="True"/>
                                    <ComboBoxItem Content="Karachi"/>
                                    <ComboBoxItem Content="Lahore"/>
                                    <ComboBoxItem Content="Islamabad"/>
                                    <ComboBoxItem Content="Faisalabad"/>
                                    <ComboBoxItem Content="Rawalpindi"/>
                                    <ComboBoxItem Content="Multan"/>
                                    <ComboBoxItem Content="Peshawar"/>
                                    <ComboBoxItem Content="Quetta"/>
                                    <ComboBoxItem Content="Sialkot"/>
                                    <ComboBoxItem Content="Gujranwala"/>
                                    <ComboBoxItem Content="Hyderabad"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Province *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="AddProvince" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="-- Select Province --" IsSelected="True"/>
                                    <ComboBoxItem Content="Punjab"/>
                                    <ComboBoxItem Content="Sindh"/>
                                    <ComboBoxItem Content="KPK"/>
                                    <ComboBoxItem Content="Balochistan"/>
                                    <ComboBoxItem Content="Islamabad Capital Territory"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Postal Code" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <TextBox Name="AddPostalCode" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" MaxLength="10"/>
                        </Border>

                        <TextBlock Text="Address *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,25">
                            <TextBox Name="AddAddress" Height="80" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Clear Form" Style="{StaticResource WarningBtn}" Click="ClearAddForm_Click" Margin="0,0,15,0"/>
                            <Button Content="💾 Save Retailer" Style="{StaticResource PrimaryBtn}" Click="SaveRetailer_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- UPDATE RETAILER TAB -->
            <Border Name="UpdateRetailerContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="✏️ Update Retailer" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                        <TextBlock Text="Select Retailer to Update *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="UpdateRetailerSelect" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                                  SelectionChanged="UpdateRetailerSelect_Changed">
                            <ComboBoxItem Content="-- Select Retailer --" IsSelected="True"/>
                        </ComboBox>

                        <TextBlock Text="Retailer/Company Name *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <TextBox Name="UpdateName" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Contact Name *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <TextBox Name="UpdateContactName" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Phone *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <TextBox Name="UpdatePhone" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <TextBox Name="UpdateEmail" Height="45" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="UpdateCity" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="Karachi"/>
                                    <ComboBoxItem Content="Lahore"/>
                                    <ComboBoxItem Content="Islamabad"/>
                                    <ComboBoxItem Content="Faisalabad"/>
                                    <ComboBoxItem Content="Rawalpindi"/>
                                    <ComboBoxItem Content="Multan"/>
                                    <ComboBoxItem Content="Peshawar"/>
                                    <ComboBoxItem Content="Quetta"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="UpdateStatus" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="Active"/>
                                    <ComboBoxItem Content="Inactive"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Address *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,25">
                            <TextBox Name="UpdateAddress" Height="80" Padding="12" FontSize="14" BorderThickness="0" Background="Transparent"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Reset" Style="{StaticResource WarningBtn}" Click="ResetUpdateForm_Click" Margin="0,0,15,0"/>
                            <Button Content="💾 Update Retailer" Style="{StaticResource PrimaryBtn}" Click="UpdateRetailerBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DELETE RETAILER TAB -->
            <Border Name="DeleteRetailerContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel MaxWidth="600">
                    <TextBlock Text="🗑️ Delete Retailer" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                    <Border Background="#FEF2F2" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Warning: Deleting a retailer is permanent and cannot be undone. Please select the retailer carefully." 
                                       Foreground="#DC2626" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Select Retailer to Delete *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                    <ComboBox Name="DeleteRetailerSelect" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                              SelectionChanged="DeleteRetailerSelect_Changed">
                        <ComboBoxItem Content="-- Select Retailer --" IsSelected="True"/>
                    </ComboBox>

                    <!-- Retailer Preview -->
                    <Border Name="DeletePreviewPanel" Background="#F8FAFC" CornerRadius="8" Padding="20" Margin="0,0,0,25" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Retailer Preview" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Name="DeletePreviewName" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Contact:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="DeletePreviewContact" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="DeletePreviewPhone" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Name="DeletePreviewEmail" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="City:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Name="DeletePreviewCity" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Name="DeletePreviewStatus" Text="-"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="🗑️ Delete Selected Retailer" Style="{StaticResource DangerBtn}" Click="ConfirmDeleteRetailer_Click" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
