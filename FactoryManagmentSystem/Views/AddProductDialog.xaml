<Window x:Class="FactoryManagmentSystem.Views.AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Add New Product - Garments Factory"
        Height="750" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Color Resources -->
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E5E7EB"/>

        <!-- Form Input Style -->
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6B7280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBackground}" CornerRadius="12" Margin="20">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="📦 Add New Product" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <TextBlock Text="Fill in the product details for the garments factory" 
                           FontSize="14" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- Form Fields -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Basic Information Section -->
                    <TextBlock Text="Basic Information" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
                    
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Product Name *" FontSize="12" FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBox Name="ProductNameTextBox" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="SKU (Stock Keeping Unit) *" FontSize="12" FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBox Name="SKUTextBox" Style="{StaticResource FormInput}" 
                                 ToolTip="Enter a unique SKU code (e.g., TSHIRT001, PROD-123)"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Description" FontSize="12" FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBox Name="DescriptionTextBox" Style="{StaticResource FormInput}" 
                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category *" FontSize="12" FontWeight="Medium" 
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                            <ComboBox Name="CategoryComboBox" Style="{StaticResource FormComboBox}">
                                <ComboBoxItem Content="T-Shirts" Tag="TShirts"/>
                                <ComboBoxItem Content="Shirts" Tag="Shirts"/>
                                <ComboBoxItem Content="Sweatshirts" Tag="Sweatshirts"/>
                                <ComboBoxItem Content="Pants" Tag="Pants"/>
                                <ComboBoxItem Content="Jeans" Tag="Jeans"/>
                                <ComboBoxItem Content="Jackets" Tag="Jackets"/>
                                <ComboBoxItem Content="Dresses" Tag="Dresses"/>
                                <ComboBoxItem Content="Hoodies" Tag="Hoodies"/>
                                <ComboBoxItem Content="Accessories" Tag="Accessories"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Brand" FontSize="12" FontWeight="Medium" 
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                            <TextBox Name="BrandTextBox" Style="{StaticResource FormInput}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pricing Information Section -->
                    <TextBlock Text="Pricing Information" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,30,0,15"/>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Sale Price (PKR) *" FontSize="12" FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBox Name="PriceTextBox" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <!-- Product Details Section -->
                    <TextBlock Text="Product Details" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,30,0,15"/>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Material *" FontSize="12" FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                        <ComboBox Name="MaterialComboBox" Style="{StaticResource FormComboBox}">
                            <ComboBoxItem Content="Cotton"/>
                            <ComboBoxItem Content="Polyester"/>
                            <ComboBoxItem Content="Cotton Blend"/>
                            <ComboBoxItem Content="Denim"/>
                            <ComboBoxItem Content="Wool"/>
                            <ComboBoxItem Content="Silk"/>
                            <ComboBoxItem Content="Linen"/>
                            <ComboBoxItem Content="Synthetic"/>
                            <ComboBoxItem Content="Leather"/>
                        </ComboBox>
                    </StackPanel>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Available Sizes" FontSize="12" FontWeight="Medium" 
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                            <TextBox Name="SizesTextBox" Style="{StaticResource FormInput}" 
                                     Text="S, M, L, XL"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Available Colors" FontSize="12" FontWeight="Medium" 
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                            <TextBox Name="ColorsTextBox" Style="{StaticResource FormInput}" 
                                     Text="Black, White, Blue"/>
                        </StackPanel>
                    </Grid>



                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="CancelButton" Content="Cancel" 
                        Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
                
                <Button Grid.Column="2" Name="SaveButton" Content="📦 Save Product" 
                        Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>