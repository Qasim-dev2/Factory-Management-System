<UserControl x:Class="FactoryManagmentSystem.Views.DepartmentAnalyticsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="ProductionColor" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="ProductionLight" Color="#F5F3FF"/>
        <SolidColorBrush x:Key="SalesColor" Color="#10B981"/>
        <SolidColorBrush x:Key="SalesLight" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SurfaceLight" Color="#F9FAFB"/>
        
        <!-- Tab Button Style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12,12,0,0" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="TabButtonActive" TargetType="Button" BasedOn="{StaticResource TabButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" 
                                CornerRadius="12,12,0,0" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,3" BorderBrush="{StaticResource AccentBlue}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" 
                CornerRadius="16" Padding="30,25" Margin="0,0,0,25">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08" ShadowDepth="2" BlurRadius="15"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border CornerRadius="15" Width="60" Height="60" Margin="0,0,20,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🏭" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Department Analytics" FontSize="32" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Real-time production and sales performance metrics" 
                                       FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Stats -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource ProductionLight}" CornerRadius="12" Padding="20,15" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Production Dept" FontSize="12" Foreground="{StaticResource ProductionColor}" FontWeight="SemiBold"/>
                            <TextBlock Name="ProductionEmployeeCount" Text="45" FontSize="24" FontWeight="Bold" 
                                       Foreground="{StaticResource ProductionColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Employees" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SalesLight}" CornerRadius="12" Padding="20,15">
                        <StackPanel>
                            <TextBlock Text="Sales Dept" FontSize="12" Foreground="{StaticResource SalesColor}" FontWeight="SemiBold"/>
                            <TextBlock Name="SalesEmployeeCount" Text="28" FontSize="24" FontWeight="Bold" 
                                       Foreground="{StaticResource SalesColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Employees" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Navigation -->
        <Border Grid.Row="1" Background="#E5E7EB" CornerRadius="12,12,0,0" Padding="5,5,5,0" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Name="AddDepartmentTabBtn" Content="➕ Add Department" 
                        Style="{StaticResource TabButtonActive}" Click="AddDepartmentTabBtn_Click"/>
                <Button Name="ViewDepartmentsTabBtn" Content="📋 View All Departments" 
                        Style="{StaticResource TabButton}" Click="ViewDepartmentsTabBtn_Click"/>
                <Button Name="ProductionTabBtn" Content="🏭 Production Department" 
                        Style="{StaticResource TabButton}" Click="ProductionTabBtn_Click"/>
                <Button Name="SalesTabBtn" Content="💼 Sales Department" 
                        Style="{StaticResource TabButton}" Click="SalesTabBtn_Click"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" 
                CornerRadius="0,16,16,16" Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08" ShadowDepth="2" BlurRadius="15"/>
            </Border.Effect>
            
            <Grid>
                <!-- Add Department Content -->
                <ScrollViewer Name="AddDepartmentContent" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Margin="30" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="➕ Add New Department" FontSize="22" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,25"/>
                        
                        <!-- Department Name -->
                        <TextBlock Text="Department Name *" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <TextBox Name="AddDepartmentNameBox" FontSize="14" Padding="12" Height="40"
                                 BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                 Background="White" Margin="0,0,0,20"/>
                        
                        <!-- Department Description -->
                        <TextBlock Text="Description" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <TextBox Name="AddDepartmentDescBox" FontSize="14" Padding="12" Height="100"
                                 BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                 Background="White" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,25"/>
                        
                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="ClearAddFormBtn" Content="Clear Form" FontSize="14" FontWeight="SemiBold"
                                    Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                    Padding="20,10" Margin="0,0,15,0" Cursor="Hand" 
                                    Click="ClearAddFormBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Button Name="AddDepartmentBtn" Content="Add Department" FontSize="14" FontWeight="SemiBold"
                                    Background="{StaticResource AccentBlue}" Foreground="White"
                                    BorderThickness="0" Padding="20,10" Cursor="Hand" 
                                    Click="AddDepartmentBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- View All Departments Content -->
                <ScrollViewer Name="ViewDepartmentsContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30">
                        <TextBlock Text="📋 All Departments" FontSize="22" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                        
                        <!-- Search and Filter Section -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Search Box -->
                            <TextBox Grid.Column="0" Name="SearchDepartmentBox" FontSize="14" Padding="12" Height="40"
                                     BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                     Background="White" Margin="0,0,15,0"/>
                            
                            <!-- Search Button -->
                            <Button Grid.Column="1" Name="SearchDepartmentBtn" Content="🔍 Search" FontSize="14" FontWeight="SemiBold"
                                    Background="{StaticResource AccentBlue}" Foreground="White"
                                    BorderThickness="0" Padding="15,10" Cursor="Hand" Margin="0,0,15,0"
                                    Click="SearchDepartmentBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <!-- Refresh Button -->
                            <Button Grid.Column="2" Name="RefreshDepartmentBtn" Content="🔄 Refresh" FontSize="14" FontWeight="SemiBold"
                                    Background="{StaticResource SalesColor}" Foreground="White"
                                    BorderThickness="0" Padding="15,10" Cursor="Hand"
                                    Click="RefreshDepartmentBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#059669"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        
                        <!-- Departments List -->
                        <Border Background="{StaticResource SurfaceLight}" CornerRadius="12" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Column Headers -->
                                <Border Grid.Row="0" Background="#E5E7EB" CornerRadius="12,12,0,0" Padding="20,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="Department Name" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="2" Text="Description" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="3" Text="Employees" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="4" Text="Status" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="5" Text="Action" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </Grid>
                                </Border>                                <!-- Departments Data -->
                                <ItemsControl Grid.Row="1" Name="DepartmentsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" Padding="20,15" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="{Binding DepartmentId}" FontWeight="Bold" 
                                                               Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="1" Text="{Binding DepartmentName}" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" 
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" 
                                                               TextWrapping="Wrap"/>
                                                    
                                                    <TextBlock Grid.Column="3" Text="{Binding EmployeeCount}" FontWeight="Bold" 
                                                               Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" 
                                                               HorizontalAlignment="Center"/>
                                                    
                                                    <Border Grid.Column="4" Background="{Binding StatusColor}" 
                                                            CornerRadius="12" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" 
                                                                   Foreground="White" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <Button Grid.Column="5" Content="🗑️ Delete" FontSize="12" FontWeight="SemiBold"
                                                            Background="#EF4444" Foreground="White"
                                                            BorderThickness="0" Padding="12,6" Cursor="Hand"
                                                            Tag="{Binding DepartmentId}"
                                                            Click="DeleteDepartmentBtn_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#DC2626"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Production Department Content -->
                <ScrollViewer Name="ProductionContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30">
                        <!-- Production Summary Cards -->
                        <TextBlock Text="📊 Production Overview" FontSize="22" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                        
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Total Production Card -->
                            <Border Grid.Column="0" Background="{StaticResource ProductionLight}" 
                                    CornerRadius="16" Padding="25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Background="{StaticResource ProductionColor}" CornerRadius="10" 
                                                Width="45" Height="45">
                                            <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Total Production" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="TotalProductionValue" Text="12,458" FontSize="36" FontWeight="Bold" 
                                               Foreground="{StaticResource ProductionColor}"/>
                                    <TextBlock Text="units this month" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="↑ 12.5%" FontSize="13" Foreground="#10B981" FontWeight="SemiBold"/>
                                        <TextBlock Text=" vs last month" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Tailors Count Card -->
                            <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="16" Padding="25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Background="{StaticResource AccentOrange}" CornerRadius="10" 
                                                Width="45" Height="45">
                                            <TextBlock Text="👔" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Active Tailors" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="ActiveTailorsCount" Text="38" FontSize="36" FontWeight="Bold" 
                                               Foreground="{StaticResource AccentOrange}"/>
                                    <TextBlock Text="working today" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="7 Managers" FontSize="13" Foreground="{StaticResource AccentOrange}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" supervising" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Avg Production Card -->
                            <Border Grid.Column="4" Background="#DBEAFE" CornerRadius="16" Padding="25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Background="{StaticResource AccentBlue}" CornerRadius="10" 
                                                Width="45" Height="45">
                                            <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Avg Per Tailor" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="AvgProductionPerTailor" Text="328" FontSize="36" FontWeight="Bold" 
                                               Foreground="{StaticResource AccentBlue}"/>
                                    <TextBlock Text="units/tailor/month" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="↑ 8.2%" FontSize="13" Foreground="#10B981" FontWeight="SemiBold"/>
                                        <TextBlock Text=" efficiency gain" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Quality Rate Card -->
                            <Border Grid.Column="6" Background="#DCFCE7" CornerRadius="16" Padding="25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Background="#10B981" CornerRadius="10" Width="45" Height="45">
                                            <TextBlock Text="✓" FontSize="22" Foreground="White" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Quality Rate" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="QualityRateValue" Text="97.8%" FontSize="36" FontWeight="Bold" 
                                               Foreground="#10B981"/>
                                    <TextBlock Text="pass rate" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="↑ 2.1%" FontSize="13" Foreground="#10B981" FontWeight="SemiBold"/>
                                        <TextBlock Text=" improvement" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Production Per Tailor Section -->
                        <TextBlock Text="👔 Production Per Tailor" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,10,0,20"/>
                        
                        <Border Background="{StaticResource SurfaceLight}" CornerRadius="12" Padding="0">
                            <!-- Column Headers -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="0" Background="#E5E7EB" CornerRadius="12,12,0,0" Padding="20,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="Tailor Name" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="2" Text="Employee ID" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="3" Text="Units Today" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="4" Text="Units/Week" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="5" Text="Units/Month" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="6" Text="Performance" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </Grid>
                                </Border>
                                
                                <ItemsControl Grid.Row="1" Name="TailorProductionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" Padding="20,15" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold" 
                                                               Foreground="{StaticResource ProductionColor}" VerticalAlignment="Center"/>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="35" Height="35" CornerRadius="17" 
                                                                Background="{StaticResource ProductionColor}" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <TextBlock Grid.Column="2" Text="{Binding EmployeeId}" FontFamily="Consolas" 
                                                               Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="3" Text="{Binding UnitsToday}" FontWeight="Bold" 
                                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="4" Text="{Binding UnitsWeek}" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="5" Text="{Binding UnitsMonth}" FontWeight="Bold" 
                                                               Foreground="{StaticResource ProductionColor}" VerticalAlignment="Center"/>
                                                    
                                                    <Grid Grid.Column="6" VerticalAlignment="Center">
                                                        <Border Background="#E5E7EB" Height="8" CornerRadius="4"/>
                                                        <Border Background="{Binding PerformanceColor}" Height="8" CornerRadius="4"
                                                                HorizontalAlignment="Left" Width="{Binding PerformanceWidth}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sales Department Content -->
                <ScrollViewer Name="SalesContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30">
                        <!-- Sales Summary Cards -->
                        <TextBlock Text="💰 Sales Overview" FontSize="22" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                        
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Total Sales Card -->
                            <Border Grid.Column="0" Background="{StaticResource SalesLight}" 
                                    CornerRadius="16" Padding="25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Background="{StaticResource SalesColor}" CornerRadius="10" 
                                                Width="45" Height="45">
                                            <TextBlock Text="💵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Total Sales" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="TotalSalesValue" Text="Rs. 847,520" FontSize="36" FontWeight="Bold" 
                                               Foreground="{StaticResource SalesColor}"/>
                                    <TextBlock Text="this month" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="↑ 18.3%" FontSize="13" Foreground="#10B981" FontWeight="SemiBold"/>
                                        <TextBlock Text=" vs last month" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Salespersons Card -->
                            <Border Grid.Column="2" Background="#DBEAFE" CornerRadius="16" Padding="25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Background="{StaticResource AccentBlue}" CornerRadius="10" 
                                                Width="45" Height="45">
                                            <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Active Salespersons" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="ActiveSalespersonsCount" Text="24" FontSize="36" FontWeight="Bold" 
                                               Foreground="{StaticResource AccentBlue}"/>
                                    <TextBlock Text="on floor today" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="4 Managers" FontSize="13" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" supervising" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Orders Count Card -->
                            <Border Grid.Column="4" Background="#FEF3C7" CornerRadius="16" Padding="25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Background="{StaticResource AccentOrange}" CornerRadius="10" 
                                                Width="45" Height="45">
                                            <TextBlock Text="🛒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Total Orders" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="TotalOrdersCount" Text="1,284" FontSize="36" FontWeight="Bold" 
                                               Foreground="{StaticResource AccentOrange}"/>
                                    <TextBlock Text="orders this month" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="↑ 22.7%" FontSize="13" Foreground="#10B981" FontWeight="SemiBold"/>
                                        <TextBlock Text=" growth" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Avg Sales Card -->
                            <Border Grid.Column="6" Background="#FCE7F3" CornerRadius="16" Padding="25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Background="#EC4899" CornerRadius="10" Width="45" Height="45">
                                            <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Avg Per Person" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="AvgSalesPerPerson" Text="Rs. 35,313" FontSize="36" FontWeight="Bold" 
                                               Foreground="#EC4899"/>
                                    <TextBlock Text="per salesperson" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="↑ 9.4%" FontSize="13" Foreground="#10B981" FontWeight="SemiBold"/>
                                        <TextBlock Text=" performance" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Sales Per Salesperson Section -->
                        <TextBlock Text="💼 Sales Per Salesperson" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,10,0,20"/>
                        
                        <Border Background="{StaticResource SurfaceLight}" CornerRadius="12" Padding="0">
                            <!-- Column Headers -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="0" Background="#E5E7EB" CornerRadius="12,12,0,0" Padding="20,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="Salesperson" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="2" Text="Employee ID" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="3" Text="Sales Today" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="4" Text="Sales/Week" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="5" Text="Sales/Month" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="6" Text="Orders" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Grid.Column="7" Text="Target" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </Grid>
                                </Border>
                                
                                <ItemsControl Grid.Row="1" Name="SalespersonSalesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" Padding="20,15" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold" 
                                                               Foreground="{StaticResource SalesColor}" VerticalAlignment="Center"/>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="35" Height="35" CornerRadius="17" 
                                                                Background="{StaticResource SalesColor}" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <TextBlock Grid.Column="2" Text="{Binding EmployeeId}" FontFamily="Consolas" 
                                                               Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="3" Text="{Binding SalesToday}" FontWeight="Bold" 
                                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="4" Text="{Binding SalesWeek}" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="5" Text="{Binding SalesMonth}" FontWeight="Bold" 
                                                               Foreground="{StaticResource SalesColor}" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="6" Text="{Binding OrderCount}" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                                                    
                                                    <Grid Grid.Column="7" VerticalAlignment="Center">
                                                        <Border Background="#E5E7EB" Height="8" CornerRadius="4"/>
                                                        <Border Background="{Binding TargetColor}" Height="8" CornerRadius="4"
                                                                HorizontalAlignment="Left" Width="{Binding TargetWidth}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
