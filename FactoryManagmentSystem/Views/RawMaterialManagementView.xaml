<UserControl x:Class="FactoryManagmentSystem.Views.RawMaterialManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Tab Button Styles -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveTabBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Styles -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6D28D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6D28D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="🧵 Raw Material Management" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Manage raw materials, track stock levels, and control production availability" FontSize="14" Foreground="#64748B" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Name="RefreshBtn" Content="🔄 Refresh" Style="{StaticResource SecondaryBtn}" Click="RefreshBtn_Click" Margin="0,0,10,0"/>
                <Button Name="LowStockAlertBtn" Content="⚠️ Low Stock Alerts" Style="{StaticResource WarningBtn}" Click="LowStockAlertBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Statistics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Materials -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🧵" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="TotalMaterialsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Total Materials" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- In Stock -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="InStockText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="In Stock" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Low Stock -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="⚠️" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="LowStockText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Low Stock" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Out of Stock -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="❌" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="OutOfStockText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Out of Stock" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Total Value -->
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="💰" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Name="TotalValueText" Text="$0" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Total Value" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tab Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Name="ViewAllTab" Content="📋 View All Materials" Style="{StaticResource ActiveTabBtn}" Tag="ViewAll" Click="TabBtn_Click"/>
            <Button Name="AddMaterialTab" Content="➕ Add Material" Style="{StaticResource TabBtn}" Tag="Add" Click="TabBtn_Click"/>
            <Button Name="UpdateMaterialTab" Content="✏️ Update Material" Style="{StaticResource TabBtn}" Tag="Update" Click="TabBtn_Click"/>
            <Button Name="DeleteMaterialTab" Content="🗑️ Delete Material" Style="{StaticResource TabBtn}" Tag="Delete" Click="TabBtn_Click"/>
            <Button Name="ProductionCheckTab" Content="🏭 Production Check" Style="{StaticResource TabBtn}" Tag="Production" Click="TabBtn_Click"/>
        </StackPanel>

        <!-- Tab Content Area -->
        <Grid Grid.Row="3">
            <!-- VIEW ALL TAB -->
            <Border Name="ViewAllContent" Background="White" CornerRadius="12" Padding="25" Visibility="Visible">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search and Filter -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,15,0">
                            <Grid>
                                <TextBlock Text="🔍 Search materials..." Foreground="#94A3B8" VerticalAlignment="Center" 
                                           Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={x:Null}}"/>
                                <TextBox Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="14" 
                                         VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <ComboBox Name="CategoryFilter" Grid.Column="1" Width="180" Height="40" Padding="10,8" FontSize="14" Margin="0,0,10,0"
                                  SelectionChanged="CategoryFilter_SelectionChanged">
                            <ComboBoxItem Content="All Categories" IsSelected="True"/>
                            <ComboBoxItem Content="Fabric"/>
                            <ComboBoxItem Content="Thread"/>
                            <ComboBoxItem Content="Button"/>
                            <ComboBoxItem Content="Zipper"/>
                            <ComboBoxItem Content="Lining"/>
                            <ComboBoxItem Content="Elastic"/>
                            <ComboBoxItem Content="Accessories"/>
                        </ComboBox>

                        <ComboBox Name="StockStatusFilter" Grid.Column="2" Width="150" Height="40" Padding="10,8" FontSize="14" Margin="0,0,10,0"
                                  SelectionChanged="StockStatusFilter_SelectionChanged">
                            <ComboBoxItem Content="All Status" IsSelected="True"/>
                            <ComboBoxItem Content="In Stock"/>
                            <ComboBoxItem Content="Low Stock"/>
                            <ComboBoxItem Content="Out of Stock"/>
                        </ComboBox>

                        <Button Grid.Column="3" Content="🔍 Search" Style="{StaticResource PrimaryBtn}" Click="SearchBtn_Click"/>
                    </Grid>

                    <!-- Data Grid -->
                    <DataGrid Name="MaterialsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" CanUserAddRows="False" RowHeight="50"
                              ColumnHeaderHeight="45" FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EDE9FE"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding MaterialId}" Width="60"/>
                            <DataGridTextColumn Header="Material Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90"/>
                            <DataGridTextColumn Header="Min Stock" Binding="{Binding MinimumStock}" Width="90"/>
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=Rs. {0:N2}}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,5" CornerRadius="12" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockStatus}" Value="In Stock">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StockStatus}" Value="Low Stock">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StockStatus}" Value="Out of Stock">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StockStatus}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockStatus}" Value="In Stock">
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StockStatus}" Value="Low Stock">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StockStatus}" Value="Out of Stock">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="👁️" Style="{StaticResource SmallActionBtn}" Tag="{Binding MaterialId}" Click="ViewMaterial_Click" ToolTip="View Details"/>
                                            <Button Content="📦" Style="{StaticResource SmallActionBtn}" Background="#10B981" Tag="{Binding MaterialId}" Click="AddStock_Click" ToolTip="Add Stock"/>
                                            <Button Content="🗑️" Style="{StaticResource SmallActionBtn}" Background="#EF4444" Tag="{Binding MaterialId}" Click="QuickDelete_Click" ToolTip="Delete"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <TextBlock Name="ShowingText" Text="Showing 1-10 of 0 entries" VerticalAlignment="Center" Foreground="#64748B"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="PrevBtn" Content="◀ Previous" Style="{StaticResource SecondaryBtn}" Click="PrevPage_Click" Margin="0,0,10,0"/>
                            <TextBlock Name="PageText" Text="Page 1 of 1" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#475569"/>
                            <Button Name="NextBtn" Content="Next ▶" Style="{StaticResource SecondaryBtn}" Click="NextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ADD MATERIAL TAB -->
            <Border Name="AddMaterialContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="➕ Add New Raw Material" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                        <TextBlock Text="Material Name *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="2" Margin="0,0,0,20">
                            <TextBox Name="AddMaterialName" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="AddCategory" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="-- Select Category --" IsSelected="True"/>
                                    <ComboBoxItem Content="Fabric"/>
                                    <ComboBoxItem Content="Thread"/>
                                    <ComboBoxItem Content="Button"/>
                                    <ComboBoxItem Content="Zipper"/>
                                    <ComboBoxItem Content="Lining"/>
                                    <ComboBoxItem Content="Elastic"/>
                                    <ComboBoxItem Content="Accessories"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="AddUnit" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="-- Select Unit --" IsSelected="True"/>
                                    <ComboBoxItem Content="Meters"/>
                                    <ComboBoxItem Content="Yards"/>
                                    <ComboBoxItem Content="Pieces"/>
                                    <ComboBoxItem Content="Kg"/>
                                    <ComboBoxItem Content="Rolls"/>
                                    <ComboBoxItem Content="Packs"/>
                                    <ComboBoxItem Content="Dozen"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Initial Quantity *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2">
                                    <TextBox Name="AddQuantity" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Minimum Stock Level *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2">
                                    <TextBox Name="AddMinStock" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unit Price (Rs.) *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2">
                                    <TextBox Name="AddUnitPrice" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Supplier (Optional)" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2">
                                    <TextBox Name="AddSupplier" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description (Optional)" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="2" Margin="0,0,0,25">
                            <TextBox Name="AddDescription" Height="80" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent" 
                                     TextWrapping="Wrap" AcceptsReturn="True"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Clear Form" Style="{StaticResource WarningBtn}" Click="ClearAddForm_Click" Margin="0,0,15,0"/>
                            <Button Content="💾 Add Material" Style="{StaticResource SuccessBtn}" Click="SaveMaterial_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- UPDATE MATERIAL TAB -->
            <Border Name="UpdateMaterialContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="✏️ Update Raw Material" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                        <TextBlock Text="Select Material to Update *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox Name="UpdateMaterialSelect" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                                  SelectionChanged="UpdateMaterialSelect_Changed">
                            <ComboBoxItem Content="-- Select Material --" IsSelected="True"/>
                        </ComboBox>

                        <!-- Material Info Panel -->
                        <Border Name="UpdateInfoPanel" Background="#F8FAFC" CornerRadius="8" Padding="20" Margin="0,0,0,20" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Stock:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Name="UpdateInfoStock" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="UpdateInfoCategory" Text="-" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Current Status:" FontWeight="SemiBold" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="UpdateInfoStatus" Text="-"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Material Name" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="2" Margin="0,0,0,20">
                            <TextBox Name="UpdateMaterialName" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="UpdateCategory" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="Fabric"/>
                                    <ComboBoxItem Content="Thread"/>
                                    <ComboBoxItem Content="Button"/>
                                    <ComboBoxItem Content="Zipper"/>
                                    <ComboBoxItem Content="Lining"/>
                                    <ComboBoxItem Content="Elastic"/>
                                    <ComboBoxItem Content="Accessories"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox Name="UpdateUnit" Height="45" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="Meters"/>
                                    <ComboBoxItem Content="Yards"/>
                                    <ComboBoxItem Content="Pieces"/>
                                    <ComboBoxItem Content="Kg"/>
                                    <ComboBoxItem Content="Rolls"/>
                                    <ComboBoxItem Content="Packs"/>
                                    <ComboBoxItem Content="Dozen"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Quantity" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2">
                                    <TextBox Name="UpdateQuantity" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Minimum Stock Level" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2">
                                    <TextBox Name="UpdateMinStock" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unit Price (Rs.)" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2">
                                    <TextBox Name="UpdateUnitPrice" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Supplier" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2">
                                    <TextBox Name="UpdateSupplier" Height="45" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Reset" Style="{StaticResource WarningBtn}" Click="ResetUpdateForm_Click" Margin="0,0,15,0"/>
                            <Button Content="💾 Update Material" Style="{StaticResource SuccessBtn}" Click="UpdateMaterialBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DELETE MATERIAL TAB -->
            <Border Name="DeleteMaterialContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <StackPanel MaxWidth="600">
                    <TextBlock Text="🗑️ Delete Raw Material" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                    <Border Background="#FEE2E2" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Warning: Deleting a material will remove it permanently from the system. This action cannot be undone." 
                                       Foreground="#991B1B" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Select Material to Delete *" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                    <ComboBox Name="DeleteMaterialSelect" Height="45" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                              SelectionChanged="DeleteMaterialSelect_Changed">
                        <ComboBoxItem Content="-- Select Material --" IsSelected="True"/>
                    </ComboBox>

                    <!-- Delete Info Panel -->
                    <Border Name="DeleteInfoPanel" Background="#FEF2F2" CornerRadius="8" Padding="20" Margin="0,0,0,25" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Material:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="DeleteInfoName" Text="-" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Name="DeleteInfoCategory" Text="-" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Current Stock:" FontWeight="SemiBold" Margin="0,0,20,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Name="DeleteInfoStock" Text="-" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Value:" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Name="DeleteInfoValue" Text="-"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🗑️ Delete Material" Style="{StaticResource DangerBtn}" Click="DeleteMaterialBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- PRODUCTION CHECK TAB -->
            <Border Name="ProductionCheckContent" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.3" BlurRadius="8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="🏭 Production Availability Check" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <TextBlock Text="Check if raw materials are available before creating production orders" FontSize="14" Foreground="#64748B" Margin="0,0,0,25"/>
                    </StackPanel>

                    <!-- Production Check Form -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="25" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="Select Materials Required for Production" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Name="ProductionMaterialSelect" Grid.Column="0" Height="45" Padding="12,10" FontSize="14" Margin="0,0,15,0">
                                    <ComboBoxItem Content="-- Select Material --" IsSelected="True"/>
                                </ComboBox>

                                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="2" Margin="0,0,15,0">
                                    <TextBox Name="ProductionQuantityRequired" Height="41" Padding="12,10" FontSize="14" BorderThickness="0" Background="Transparent"
                                             ToolTip="Quantity Required"/>
                                </Border>

                                <Button Grid.Column="2" Content="➕ Add to Check" Style="{StaticResource PrimaryBtn}" Click="AddToProductionCheck_Click"/>
                            </Grid>

                            <!-- Materials to Check List -->
                            <DataGrid Name="ProductionCheckGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="200"
                                      Background="White" BorderThickness="1" BorderBrush="#E2E8F0" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column" CanUserAddRows="False" RowHeight="40"
                                      ColumnHeaderHeight="40" FontSize="13">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*"/>
                                    <DataGridTextColumn Header="Required" Binding="{Binding RequiredQuantity}" Width="100"/>
                                    <DataGridTextColumn Header="Available" Binding="{Binding AvailableQuantity}" Width="100"/>
                                    <DataGridTemplateColumn Header="Status" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,4" CornerRadius="10" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                        <Setter Property="Text" Value="✅ Available"/>
                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                        <Setter Property="Text" Value="❌ Insufficient"/>
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✖" Style="{StaticResource SmallActionBtn}" Background="#EF4444" 
                                                        Tag="{Binding MaterialId}" Click="RemoveFromProductionCheck_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                <Button Content="🔄 Clear All" Style="{StaticResource WarningBtn}" Click="ClearProductionCheck_Click" Margin="0,0,15,0"/>
                                <Button Content="✅ Check Availability" Style="{StaticResource PrimaryBtn}" Click="CheckProductionAvailability_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Production Result Panel -->
                    <Border Name="ProductionResultPanel" Grid.Row="2" CornerRadius="12" Padding="25" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Name="ProductionResultTitle" Text="" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                            <TextBlock Name="ProductionResultMessage" Text="" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <Button Name="CreateProductionOrderBtn" Content="🏭 Create Production Order" Style="{StaticResource SuccessBtn}" 
                                    Click="CreateProductionOrder_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
