<Window x:Class="FactoryManagmentSystem.Views.TailorSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Tailors for Production" 
        Height="600" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="WorkloadBadge" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                Padding="20,15" 
                CornerRadius="5"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Select Tailors for Production Order" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock x:Name="txtOrderInfo" 
                           Text="Order Details" 
                           FontSize="14" 
                           Foreground="#BDC3C7"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Instructions -->
        <Border Grid.Row="1" 
                Background="#E3F2FD" 
                Padding="15" 
                CornerRadius="5"
                BorderBrush="#2196F3"
                BorderThickness="1"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock FontSize="13" 
                           Foreground="#1976D2"
                           FontWeight="SemiBold">
                    <Run Text="📋 Instructions:"/>
                </TextBlock>
                <TextBlock FontSize="12" 
                           Foreground="#1565C0"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap">
                    • Select one or more tailors by checking the boxes
                    <LineBreak/>
                    • Tailors are sorted by current workload (Available first)
                    <LineBreak/>
                    • Consider workload status when assigning multiple tailors
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Available Tailors DataGrid -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="5"
                BorderBrush="#DEE2E6"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        Padding="15,10"
                        BorderBrush="#DEE2E6"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                  Text="Available Tailors" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  Foreground="#495057"
                                  VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Select All"
                                    x:Name="btnSelectAll"
                                    Padding="10,5"
                                    Margin="5,0"
                                    Background="#17A2B8"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="11"
                                    Click="BtnSelectAll_Click"/>
                            <Button Content="Clear All"
                                    x:Name="btnClearAll"
                                    Padding="10,5"
                                    Background="#6C757D"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="11"
                                    Click="BtnClearAll_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="dgTailors"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA"
                          BorderThickness="0"
                          HeadersVisibility="Column">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E9ECEF"/>
                            <Setter Property="Foreground" Value="#495057"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderBrush" Value="#DEE2E6"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ID" 
                                          Binding="{Binding EmployeeID}" 
                                          Width="60"/>

                        <DataGridTextColumn Header="Tailor Name" 
                                          Binding="{Binding TailorName}" 
                                          Width="180"/>

                        <DataGridTextColumn Header="Specialization" 
                                          Binding="{Binding Specialization}" 
                                          Width="150"/>

                        <DataGridTextColumn Header="Piece Rate" 
                                          Binding="{Binding PieceRateDisplay}" 
                                          Width="100"/>

                        <DataGridTextColumn Header="Active Jobs" 
                                          Binding="{Binding ActiveAssignments}" 
                                          Width="100"/>

                        <DataGridTextColumn Header="Total Completed" 
                                          Binding="{Binding TotalPiecesCompleted}" 
                                          Width="130"/>

                        <DataGridTemplateColumn Header="Workload" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource WorkloadBadge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WorkloadStatus}" Value="Available">
                                                        <Setter Property="Background" Value="#D4EDDA"/>
                                                        <Setter Property="BorderBrush" Value="#28A745"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WorkloadStatus}" Value="Light">
                                                        <Setter Property="Background" Value="#D1ECF1"/>
                                                        <Setter Property="BorderBrush" Value="#17A2B8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WorkloadStatus}" Value="Moderate">
                                                        <Setter Property="Background" Value="#FFF3CD"/>
                                                        <Setter Property="BorderBrush" Value="#FFC107"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WorkloadStatus}" Value="Heavy">
                                                        <Setter Property="Background" Value="#F8D7DA"/>
                                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding WorkloadStatus}" 
                                                 FontSize="11" 
                                                 FontWeight="SemiBold"
                                                 TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WorkloadStatus}" Value="Available">
                                                            <Setter Property="Foreground" Value="#155724"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WorkloadStatus}" Value="Light">
                                                            <Setter Property="Foreground" Value="#0C5460"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WorkloadStatus}" Value="Moderate">
                                                            <Setter Property="Foreground" Value="#856404"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WorkloadStatus}" Value="Heavy">
                                                            <Setter Property="Foreground" Value="#721C24"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Selected Count -->
        <Border Grid.Row="3" 
                Background="#E9ECEF" 
                Padding="15,10" 
                CornerRadius="5"
                Margin="0,15,0,15">
            <TextBlock x:Name="txtSelectedCount" 
                       Text="Selected Tailors: 0" 
                       FontSize="14" 
                       FontWeight="SemiBold"
                       Foreground="#495057"/>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Left"
                    Background="#6C757D"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnCancel_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnAssign"
                    Content="Assign Selected Tailors"
                    Width="180"
                    Height="35"
                    Background="#28A745"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnAssign_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
