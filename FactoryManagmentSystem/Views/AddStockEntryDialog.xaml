<Window x:Class="FactoryManagmentSystem.Views.AddStockEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Stock Entry" Height="650" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Input Label Style -->
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Required Label Style -->
        <Style x:Key="RequiredLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Input Field Style -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Header -->
                <Border CornerRadius="12" Padding="20" Margin="0,0,0,25">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="📦 Add New Stock Entry" FontSize="22" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Enter stock details for the new entry" FontSize="13" 
                                   Foreground="#E0E7FF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Product Information Section -->
                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.2" BlurRadius="6"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🏷️ Product Information" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Style="{StaticResource RequiredLabel}">
                            <Run Text="Product"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <ComboBox Name="ProductComboBox" Style="{StaticResource InputComboBox}" 
                                  SelectionChanged="ProductComboBox_SelectionChanged">
                            <ComboBoxItem Content="-- Select Product --" IsSelected="True"/>
                        </ComboBox>

                        <TextBlock Text="Product ID" Style="{StaticResource InputLabel}"/>
                        <TextBox Name="ProductIdTextBox" Style="{StaticResource InputField}" 
                                 IsReadOnly="True" Background="#F3F4F6"/>

                        <TextBlock Text="Category" Style="{StaticResource InputLabel}"/>
                        <TextBox Name="CategoryTextBox" Style="{StaticResource InputField}" 
                                 IsReadOnly="True" Background="#F3F4F6"/>
                    </StackPanel>
                </Border>

                <!-- Batch Information Section -->
                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.2" BlurRadius="6"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🔢 Batch Information" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Style="{StaticResource RequiredLabel}">
                            <Run Text="Batch Number"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="BatchNoTextBox" Grid.Column="0" Style="{StaticResource InputField}" 
                                     Margin="0,0,10,15"/>
                            <Button Grid.Column="1" Content="🔄 Generate" Style="{StaticResource SecondaryButton}" 
                                    Click="GenerateBatchNo_Click" VerticalAlignment="Top" Margin="0,0,0,15"/>
                        </Grid>

                        <TextBlock Text="Entry Date" Style="{StaticResource InputLabel}"/>
                        <DatePicker Name="EntryDatePicker" SelectedDate="{x:Static sys:DateTime.Now}" 
                                    Margin="0,0,0,15" Padding="10,8" FontSize="14"
                                    xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                    </StackPanel>
                </Border>

                <!-- Quantity & Status Section -->
                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.2" BlurRadius="6"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📊 Quantity &amp; Status" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Style="{StaticResource RequiredLabel}">
                            <Run Text="Quantity"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <TextBox Name="QuantityTextBox" Style="{StaticResource InputField}" 
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>

                        <TextBlock Style="{StaticResource RequiredLabel}">
                            <Run Text="Stock Status"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <ComboBox Name="StockStatusComboBox" Style="{StaticResource InputComboBox}">
                            <ComboBoxItem Content="Ready (Finished Products)" IsSelected="True"/>
                            <ComboBoxItem Content="In Process (Manufacturing)"/>
                            <ComboBoxItem Content="Shipped"/>
                            <ComboBoxItem Content="Delivered"/>
                        </ComboBox>

                        <!-- Progress (for In Process) -->
                        <StackPanel Name="ProgressPanel" Visibility="Collapsed">
                            <TextBlock Text="Progress Percentage (%)" Style="{StaticResource InputLabel}"/>
                            <TextBox Name="ProgressTextBox" Style="{StaticResource InputField}" Text="0"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Additional Information Section -->
                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="LightGray" Opacity="0.2" BlurRadius="6"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📝 Additional Information" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Location/Warehouse" Style="{StaticResource InputLabel}"/>
                        <ComboBox Name="LocationComboBox" Style="{StaticResource InputComboBox}">
                            <ComboBoxItem Content="Main Warehouse" IsSelected="True"/>
                            <ComboBoxItem Content="Production Floor"/>
                            <ComboBoxItem Content="Finishing Unit"/>
                            <ComboBoxItem Content="Quality Control"/>
                            <ComboBoxItem Content="Packing Area"/>
                        </ComboBox>

                        <TextBlock Text="Notes" Style="{StaticResource InputLabel}"/>
                        <TextBox Name="NotesTextBox" Style="{StaticResource InputField}" Height="70" 
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="💾 Save Entry" Style="{StaticResource SuccessButton}"
                            Click="SaveButton_Click" MinWidth="130"/>
                    <Button Grid.Column="3" Content="💾 Save &amp; Add Another" Style="{StaticResource PrimaryButton}"
                            Click="SaveAndAddButton_Click" MinWidth="160"/>
                    <Button Grid.Column="5" Content="❌ Cancel" Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click" MinWidth="100"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
