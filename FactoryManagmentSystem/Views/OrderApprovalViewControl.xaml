<UserControl x:Class="FactoryManagmentSystem.Views.OrderApprovalViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- Status Badge Styles -->
        <Style x:Key="PendingBadge" TargetType="Border">
            <Setter Property="Background" Value="#FFF3CD"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="ApprovedBadge" TargetType="Border">
            <Setter Property="Background" Value="#D4EDDA"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="RejectedBadge" TargetType="Border">
            <Setter Property="Background" Value="#F8D7DA"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="CheckButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#17A2B8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ApproveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="RejectButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                Padding="20,15" 
                CornerRadius="5"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Order Approval Management" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Review and approve sales orders based on raw material availability" 
                               FontSize="14" 
                               Foreground="#BDC3C7"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Pending Orders: " 
                               FontSize="16" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPendingCount" 
                               Text="0" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#FFC107"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="1" 
                Background="White" 
                Padding="15" 
                CornerRadius="5"
                Margin="0,0,0,15"
                BorderBrush="#DEE2E6"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnCheckMaterials" 
                            Content="🔍 Check Materials" 
                            Style="{StaticResource CheckButton}"
                            Click="BtnCheckMaterials_Click"
                            IsEnabled="False"/>
                    
                    <Button x:Name="btnApprove" 
                            Content="✔ Approve Order" 
                            Style="{StaticResource ApproveButton}"
                            Click="BtnApprove_Click"
                            IsEnabled="False"/>
                    
                    <Button x:Name="btnReject" 
                            Content="✖ Reject Order" 
                            Style="{StaticResource RejectButton}"
                            Click="BtnReject_Click"
                            IsEnabled="False"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="btnRefresh" 
                        Content="🔄 Refresh" 
                        Style="{StaticResource RefreshButton}"
                        Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- Pending Approvals DataGrid -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="5"
                BorderBrush="#DEE2E6"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column Headers Info -->
                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        Padding="15,10"
                        BorderBrush="#DEE2E6"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Pending Approval Requests" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="#495057"/>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="dgPendingApprovals"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          SelectionChanged="DgPendingApprovals_SelectionChanged"
                          MouseDoubleClick="DgPendingApprovals_MouseDoubleClick">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E9ECEF"/>
                            <Setter Property="Foreground" Value="#495057"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderBrush" Value="#DEE2E6"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" 
                                          Binding="{Binding ApprovalID}" 
                                          Width="60"/>

                        <DataGridTextColumn Header="Order Type" 
                                          Binding="{Binding OrderType}" 
                                          Width="100"/>

                        <DataGridTextColumn Header="Order ID" 
                                          Binding="{Binding OrderID}" 
                                          Width="80"/>

                        <DataGridTextColumn Header="Customer" 
                                          Binding="{Binding CustomerName}" 
                                          Width="150"/>

                        <DataGridTextColumn Header="Salesperson" 
                                          Binding="{Binding SalespersonName}" 
                                          Width="150"/>

                        <DataGridTextColumn Header="Order Amount" 
                                          Binding="{Binding OrderAmountDisplay}" 
                                          Width="120"/>

                        <DataGridTextColumn Header="Priority" 
                                          Binding="{Binding Priority}" 
                                          Width="90"/>

                        <DataGridTextColumn Header="Request Date" 
                                          Binding="{Binding RequestDate, StringFormat='MMM dd, yyyy HH:mm'}" 
                                          Width="150"/>

                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PendingBadge}">
                                        <TextBlock Text="{Binding Status}" 
                                                 FontSize="11" 
                                                 FontWeight="SemiBold"
                                                 Foreground="#856404"
                                                 TextAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Phone" 
                                          Binding="{Binding SalespersonPhone}" 
                                          Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- No Data Message -->
                <TextBlock Grid.Row="1"
                          x:Name="txtNoData"
                          Text="No pending approval requests"
                          FontSize="16"
                          Foreground="#6C757D"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="#343A40" 
                Padding="15,10" 
                CornerRadius="5"
                Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          x:Name="txtStatusMessage" 
                          Text="Ready - Select an order to check materials or approve/reject" 
                          FontSize="12" 
                          Foreground="White"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                          x:Name="txtLastUpdate" 
                          Text="" 
                          FontSize="11" 
                          Foreground="#ADB5BD"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
