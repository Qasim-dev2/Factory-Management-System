<UserControl x:Class="FactoryManagmentSystem.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F8F9FA">

    <UserControl.Resources>
        <!-- Enhanced Button Styles -->
        <Style x:Key="MainActionButton" TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="30,15"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="MinWidth" Value="250"/>
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" 
                                          FontSize="32" 
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,10"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004085"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#545B62"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3E444A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7E34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D39E00"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Additional Styles for Browse Employees -->
        <SolidColorBrush x:Key="AccentBlue">#007BFF</SolidColorBrush>
        <SolidColorBrush x:Key="AccentGreen">#28A745</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimary">#212529</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#6C757D</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceLight">#F8F9FA</SolidColorBrush>
        <SolidColorBrush x:Key="BorderLight">#DEE2E6</SolidColorBrush>
        <SolidColorBrush x:Key="CardBackground">White</SolidColorBrush>

        <Style x:Key="PremiumButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#007BFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#007BFF" Offset="0"/>
                    <GradientStop Color="#0056B3" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                <TextBlock Text="🏭" FontSize="36" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <TextBlock Text="Employee Management System" 
                           FontSize="32" FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="30">
            
            <!-- Main Menu Buttons (Default View) -->
            <Grid x:Name="MainMenuGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Choose Employee Management Action" 
                          FontSize="24" FontWeight="Bold" 
                          Foreground="#374151" 
                          HorizontalAlignment="Center" 
                          Margin="0,20,0,40"/>
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add Employee Button -->
                    <Button Grid.Row="0" Grid.Column="0" 
                            Style="{StaticResource MainActionButton}"
                            Tag="👤➕"
                            Click="ShowAddEmployee_Click">
                        <StackPanel>
                            <TextBlock Text="Add New Employee" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Register new employee to system" FontSize="12" Opacity="0.8" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Update Employee Button -->
                    <Button Grid.Row="0" Grid.Column="1" 
                            Style="{StaticResource MainActionButton}"
                            Tag="✏️"
                            Click="ShowUpdateEmployee_Click">
                        <StackPanel>
                            <TextBlock Text="Update Employee" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Modify employee information" FontSize="12" Opacity="0.8" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Browse All Employees Button -->
                    <Button Grid.Row="0" Grid.Column="2" 
                            Tag="👥"
                            Click="ShowBrowseEmployees_Click">
                        <StackPanel>
                            <TextBlock Text="Browse All Employees" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="View, search &amp; filter employees" FontSize="12" Opacity="0.8" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MainActionButton}">
                                <Setter Property="Background" Value="#17A2B8"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#138496"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Delete Employee Button -->
                    <Button Grid.Row="1" Grid.Column="0" 
                            Tag="🗑️"
                            Click="ShowDeleteEmployee_Click">
                        <StackPanel>
                            <TextBlock Text="Delete Employee" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Remove employee from system" FontSize="12" Opacity="0.8" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MainActionButton}">
                                <Setter Property="Background" Value="#DC3545"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C82333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Promote/Demote Employee Button -->
                    <Button Grid.Row="1" Grid.Column="1" 
                            Tag="📈📉"
                            Click="ShowPromoteEmployee_Click">
                        <StackPanel>
                            <TextBlock Text="Promote/Demote" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Change employee role &amp; salary" FontSize="12" Opacity="0.8" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MainActionButton}">
                                <Setter Property="Background" Value="#FFC107"/>
                                <Setter Property="Foreground" Value="#212529"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E0A800"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>

            <!-- Add Employee Content -->
            <Grid x:Name="AddEmployeeGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Style="{StaticResource BackButton}" Click="BackToMain_Click">
                        ← Back to Menu
                    </Button>
                    <TextBlock Text="Add New Employee" FontSize="24" FontWeight="Bold" 
                              Foreground="#374151" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                            CornerRadius="8" Padding="40" MaxWidth="700">
                        <StackPanel>
                            <!-- Personal Information Section -->
                            <TextBlock Text="📋 Personal Information" FontSize="18" FontWeight="Bold" 
                                      Foreground="#007BFF" Margin="0,0,0,15"/>
                            
                            <!-- First Name -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="First Name: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddFirstNameTextBox" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                            </Grid>

                            <!-- Last Name -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Last Name: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddLastNameTextBox" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                            </Grid>

                            <!-- CNIC -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CNIC: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddCNICTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="15" ToolTip="Format: 12345-1234567-1"/>
                            </Grid>

                            <!-- Email -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Email: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddEmailTextBox" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                            </Grid>

                            <!-- Phone -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Phone: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddPhoneTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="15" ToolTip="Format: 03XX-XXXXXXX"/>
                            </Grid>

                            <!-- Address -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Address: *" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                <TextBox x:Name="AddAddressTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        Height="60" AcceptsReturn="True" TextWrapping="Wrap" 
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                            </Grid>

                            <!-- Emergency Contact -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Emergency Contact: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddEmergencyContactTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="15" ToolTip="Emergency contact number"/>
                            </Grid>

                            <!-- Work Information Section -->
                            <TextBlock Text="💼 Work Information" FontSize="18" FontWeight="Bold" 
                                      Foreground="#007BFF" Margin="0,0,0,15"/>

                            <!-- Department -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Department: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="AddDepartmentComboBox" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"/>
                            </Grid>

                            <!-- Position/Role -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Position/Role: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="AddPositionComboBox" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"/>
                            </Grid>

                            <!-- Salary -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Salary (Rs.): *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddSalaryTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        ToolTip="Minimum salary: Rs. 25,000"/>
                            </Grid>

                            <!-- Hire Date -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Join/Hire Date: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <DatePicker x:Name="AddHireDatePicker" Grid.Column="1" FontSize="14"/>
                            </Grid>

                            <!-- Login Credentials Section -->
                            <TextBlock Text="🔐 Login Credentials" FontSize="18" FontWeight="Bold" 
                                      Foreground="#007BFF" Margin="0,0,0,15"/>

                            <!-- Username -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Username: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddUsernameTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="50" ToolTip="Unique username for login"/>
                            </Grid>

                            <!-- PIN -->
                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PIN (4 digits): *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="AddPINTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="4" ToolTip="4-digit PIN for login (e.g., 1234)"/>
                            </Grid>

                            <!-- Required Fields Note -->
                            <TextBlock Text="* All fields are required" FontSize="12" FontStyle="Italic" 
                                      Foreground="#DC3545" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                            <!-- Add Button -->
                            <Button Style="{StaticResource ActionButton}" 
                                    Click="AddEmployee_Click" HorizontalAlignment="Center" MinWidth="200" 
                                    Content="✓ Add Employee" FontSize="16" Padding="30,12"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Update Employee Content -->
            <Grid x:Name="UpdateEmployeeGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Style="{StaticResource BackButton}" Click="BackToMain_Click">
                        ← Back to Menu
                    </Button>
                    <TextBlock Text="Update Employee Information" FontSize="24" FontWeight="Bold" 
                              Foreground="#374151" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                            CornerRadius="8" Padding="40" MaxWidth="700">
                        <StackPanel>
                            <!-- Employee Selection -->
                            <TextBlock Text="Select Employee to Update" FontSize="18" FontWeight="Bold" 
                                      Foreground="#007BFF" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Select Employee: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="UpdateEmployeeComboBox" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                         SelectionChanged="UpdateEmployeeComboBox_SelectionChanged"/>
                            </Grid>

                            <!-- Personal Information Section -->
                            <TextBlock Text="📋 Personal Information" FontSize="18" FontWeight="Bold" 
                                      Foreground="#007BFF" Margin="0,0,0,15"/>
                            
                            <!-- First Name -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="First Name: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdateFirstNameTextBox" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                            </Grid>

                            <!-- Last Name -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Last Name: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdateLastNameTextBox" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                            </Grid>

                            <!-- CNIC -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CNIC: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdateCNICTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="15" ToolTip="Format: 12345-1234567-1"/>
                            </Grid>

                            <!-- Email -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Email: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdateEmailTextBox" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                            </Grid>

                            <!-- Phone -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Phone: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdatePhoneTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="15" ToolTip="Format: 03XX-XXXXXXX"/>
                            </Grid>

                            <!-- Address -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Address: *" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                <TextBox x:Name="UpdateAddressTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        Height="60" AcceptsReturn="True" TextWrapping="Wrap" 
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                            </Grid>

                            <!-- Emergency Contact -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Emergency Contact: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdateEmergencyContactTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="15" ToolTip="Emergency contact number"/>
                            </Grid>

                            <!-- Work Information Section -->
                            <TextBlock Text="💼 Work Information" FontSize="18" FontWeight="Bold" 
                                      Foreground="#007BFF" Margin="0,0,0,15"/>

                            <!-- Department -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Department: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="UpdateDepartmentComboBox" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"/>
                            </Grid>

                            <!-- Position/Role -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Position/Role: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="UpdatePositionComboBox" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"/>
                            </Grid>

                            <!-- Salary -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Salary (Rs.): *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdateSalaryTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        ToolTip="Minimum salary: Rs. 25,000"/>
                            </Grid>

                            <!-- Hire Date -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Join/Hire Date: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <DatePicker x:Name="UpdateHireDatePicker" Grid.Column="1" FontSize="14"/>
                            </Grid>

                            <!-- Login Credentials Section -->
                            <TextBlock Text="🔐 Login Credentials" FontSize="18" FontWeight="Bold" 
                                      Foreground="#007BFF" Margin="0,0,0,15"/>

                            <!-- Username -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Username: *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdateUsernameTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="50" ToolTip="Unique username for login"/>
                            </Grid>

                            <!-- PIN -->
                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PIN (4 digits): *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="UpdatePINTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" 
                                        MaxLength="4" ToolTip="4-digit PIN for login (e.g., 1234)"/>
                            </Grid>

                            <!-- Required Fields Note -->
                            <TextBlock Text="* All fields are required" FontSize="12" FontStyle="Italic" 
                                      Foreground="#DC3545" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                            <!-- Update Button -->
                            <Button Style="{StaticResource ActionButton}" 
                                    Click="UpdateEmployee_Click" HorizontalAlignment="Center" MinWidth="200" 
                                    Content="✓ Update Employee" FontSize="16" Padding="30,12"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Delete Employee Content -->
            <Grid x:Name="DeleteEmployeeGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Style="{StaticResource BackButton}" Click="BackToMain_Click">
                        ← Back to Menu
                    </Button>
                    <TextBlock Text="Delete Employee" FontSize="24" FontWeight="Bold" 
                              Foreground="#374151" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
                
                <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                        CornerRadius="8" Padding="40" MaxWidth="600" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Employee Selection -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Select Employee:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DeleteEmployeeComboBox" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                     SelectionChanged="DeleteEmployeeComboBox_SelectionChanged"/>
                        </Grid>

                        <!-- Employee Details -->
                        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" 
                                CornerRadius="4" Padding="20" x:Name="DeleteEmployeeDetailsPanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Employee Details:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <TextBlock x:Name="DeleteEmployeeDetails" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <!-- Delete Button -->
                        <Button Grid.Row="4" Style="{StaticResource DangerButton}" 
                                Click="DeleteEmployee_Click" HorizontalAlignment="Center" MinWidth="150"
                                x:Name="DeleteEmployeeButton" IsEnabled="False">
                            Delete Employee
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Promote/Demote Employee Content -->
            <Grid x:Name="PromoteEmployeeGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Style="{StaticResource BackButton}" Click="BackToMain_Click">
                        ← Back to Menu
                    </Button>
                    <TextBlock Text="Promote/Demote Employee" FontSize="24" FontWeight="Bold" 
                              Foreground="#374151" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
                
                <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                        CornerRadius="8" Padding="40" MaxWidth="600" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Employee Selection -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Select Employee:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PromoteEmployeeComboBox" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                     SelectionChanged="PromoteEmployeeComboBox_SelectionChanged"/>
                        </Grid>

                        <!-- Current Role -->
                        <Grid Grid.Row="2" x:Name="PromoteCurrentRolePanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Current Role:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#E9ECEF" CornerRadius="4" Padding="12">
                                <TextBlock x:Name="PromoteCurrentRoleText" FontSize="14" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- New Role -->
                        <Grid Grid.Row="4" x:Name="PromoteNewRolePanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="New Role:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PromoteNewRoleComboBox" Grid.Column="1" Style="{StaticResource ComboBoxStyle}"/>
                        </Grid>

                        <!-- New Salary -->
                        <Grid Grid.Row="6" x:Name="PromoteNewSalaryPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="New Salary:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="PromoteNewSalaryTextBox" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                        </Grid>

                        <!-- Promotion Reason -->
                        <Grid Grid.Row="8" x:Name="PromoteReasonPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reason:" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,10,0,0"/>
                            <TextBox x:Name="PromoteReasonTextBox" Grid.Column="1" Style="{StaticResource InputStyle}"
                                    Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center"
                                   x:Name="PromoteButtonsPanel" Visibility="Collapsed">
                            <Button Style="{StaticResource ActionButton}" Click="PromoteEmployee_Click" Margin="5">
                                Promote Employee
                            </Button>
                            <Button Style="{StaticResource WarningButton}" Click="DemoteEmployee_Click" Margin="5">
                                Demote Employee
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Browse All Employees Content -->
            <Grid x:Name="BrowseEmployeesGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Style="{StaticResource BackButton}" Click="BackToMain_Click">
                        ← Back to Menu
                    </Button>
                    <TextBlock Text="Browse All Employees" FontSize="24" FontWeight="Bold" 
                              Foreground="#374151" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock x:Name="TotalEmployeesLabel" Text="(Loading...)" FontSize="16" 
                              Foreground="#6C757D" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>

                <!-- Search Section -->
                <Border Grid.Row="1" Background="{StaticResource CardBackground}" 
                        CornerRadius="12" Padding="20,15" Margin="0,0,0,20"
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchEmployeeBox" Grid.Column="0" 
                                Style="{StaticResource SearchTextBox}"
                                Text="Search employees by name, ID, or department..."
                                GotFocus="SearchEmployeeBox_GotFocus"
                                LostFocus="SearchEmployeeBox_LostFocus"
                                TextChanged="SearchEmployeeBox_TextChanged"/>

                        <Button x:Name="RefreshListBtn" Grid.Column="1" Content="🔄 Refresh" 
                                Style="{StaticResource ActionButton}"
                                Click="RefreshListBtn_Click" Margin="12,0,0,0" Padding="12"/>
                    </Grid>
                </Border>

                <!-- Filter and Sort Section -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceLight}" 
                        CornerRadius="12" Padding="20,15" Margin="0,0,0,20"
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filters -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filters:" FontWeight="SemiBold" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            
                            <ComboBox x:Name="DepartmentFilterCombo" Width="180" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="All Departments"/>
                            </ComboBox>
                            
                            <ComboBox x:Name="PositionFilterCombo" Width="130" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="All Positions"/>
                            </ComboBox>
                            
                            <ComboBox x:Name="ShiftFilterCombo" Width="130" SelectedIndex="0" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="All Shifts"/>
                                <ComboBoxItem Content="Day Shift"/>
                                <ComboBoxItem Content="Night Shift"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Sort Options -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sort by:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SortByCombo" Width="140" SelectedIndex="0" SelectionChanged="SortChanged">
                                <ComboBoxItem Content="Employee ID"/>
                                <ComboBoxItem Content="Name (A-Z)"/>
                                <ComboBoxItem Content="Name (Z-A)"/>
                                <ComboBoxItem Content="Join Date (New)"/>
                                <ComboBoxItem Content="Join Date (Old)"/>
                                <ComboBoxItem Content="Department"/>
                                <ComboBoxItem Content="Position"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Employee List Section -->
                <Border Grid.Row="3" Background="{StaticResource CardBackground}" 
                        CornerRadius="15" Padding="0" 
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Enhanced Column Headers -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceLight}" 
                                CornerRadius="15,15,0,0" Padding="25,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Photo" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Employee Details" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Employee ID" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Department" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Position" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Shift" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="Join Date" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="Actions" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Employee List with Enhanced Design -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="EmployeeScrollViewer">
                            <ItemsControl x:Name="EmployeeItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" Padding="25,15" 
                                                BorderBrush="{StaticResource BorderLight}" 
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="45" Height="45" 
                                                        CornerRadius="22" Background="{StaticResource AccentBlue}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="15"
                                                               Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding Email}" FontSize="12" 
                                                               Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Phone}" FontSize="11" 
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="2" Text="{Binding EmployeeId}" 
                                                           FontFamily="Consolas" FontWeight="Bold" FontSize="13"
                                                           Foreground="{StaticResource AccentBlue}" 
                                                           VerticalAlignment="Center"/>
                                                
                                                <Border Grid.Column="3" Background="#EBF8FF" 
                                                        CornerRadius="15" Padding="10,6" 
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Department}" FontSize="12" 
                                                               Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold"/>
                                                </Border>
                                                
                                                <TextBlock Grid.Column="4" Text="{Binding Role}" FontSize="13"
                                                           Foreground="{StaticResource TextPrimary}" FontWeight="Medium"
                                                           VerticalAlignment="Center"/>
                                                
                                                <Border Grid.Column="5" Background="#F0FDF4" 
                                                        CornerRadius="15" Padding="10,6" 
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShiftType}" FontSize="12" 
                                                               Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold"/>
                                                </Border>
                                                
                                                <TextBlock Grid.Column="6" Text="{Binding JoinDate, StringFormat=dd/MM/yyyy}" FontSize="13"
                                                           Foreground="{StaticResource TextSecondary}" 
                                                           VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="7" Orientation="Horizontal" 
                                                            VerticalAlignment="Center">
                                                    <Button Content="👁️" Padding="8" Margin="0,0,5,0" FontSize="12"
                                                            Style="{StaticResource PremiumButton}"
                                                            Click="ViewEmployeeDetailsBtn_Click" 
                                                            Tag="{Binding EmployeeId}" ToolTip="View Details"/>
                                                    <Button Content="✏️" Padding="8" Margin="0,0,5,0" FontSize="12"
                                                            Style="{StaticResource WarningButton}"
                                                            Click="EditEmployeeBtn_Click" 
                                                            Tag="{Binding EmployeeId}" ToolTip="Edit Employee"/>
                                                    <Button Content="🗑️" Padding="8" FontSize="12"
                                                            Style="{StaticResource DangerButton}"
                                                            Click="DeleteSingleEmployeeBtn_Click" 
                                                            Tag="{Binding EmployeeId}" ToolTip="Delete Employee"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Enhanced Pagination -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceLight}" 
                                CornerRadius="0,0,15,15" Padding="25,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Page Info -->
                                <TextBlock Grid.Column="0" x:Name="PageInfoLabel" 
                                          Text="Showing 1-15 of 100 employees" FontWeight="SemiBold"
                                          VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>

                                <!-- Pagination Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="FirstPageBtn" Content="⏮" FontSize="16" Padding="8"
                                            Style="{StaticResource ActionButton}" Click="FirstPageBtn_Click" Margin="2"/>
                                    <Button x:Name="PrevPageBtn" Content="◀" FontSize="16" Padding="8"
                                            Style="{StaticResource ActionButton}" Click="PrevPageBtn_Click" Margin="2"/>
                                    
                                    <TextBlock x:Name="CurrentPageLabel" Text="Page 1 of 7" FontWeight="SemiBold"
                                              VerticalAlignment="Center" Margin="15,0" 
                                              Foreground="{StaticResource TextPrimary}"/>
                                    
                                    <Button x:Name="NextPageBtn" Content="▶" FontSize="16" Padding="8"
                                            Style="{StaticResource ActionButton}" Click="NextPageBtn_Click" Margin="2"/>
                                    <Button x:Name="LastPageBtn" Content="⏭" FontSize="16" Padding="8"
                                            Style="{StaticResource ActionButton}" Click="LastPageBtn_Click" Margin="2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>