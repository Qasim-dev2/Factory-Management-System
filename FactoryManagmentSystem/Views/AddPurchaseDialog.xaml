<Window x:Class="FactoryManagmentSystem.Views.NewPurchaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Raw Material Purchase" Height="450" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f5f5f5">
    
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🛒 Add Raw Material Purchase" FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
            <TextBlock Text="Record a new raw material purchase" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Form -->
        <ScrollViewer Grid.Row="1" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Material Name *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtMaterialName" Style="{StaticResource InputField}" />
                
                <TextBlock Text="Purchase Date *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="dpPurchaseDate" FontSize="13" Padding="5"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Quantity *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtQuantity" Style="{StaticResource InputField}" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Unit" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbUnit" FontSize="13" Padding="8">
                            <ComboBoxItem Content="Meters" IsSelected="True"/>
                            <ComboBoxItem Content="Yards"/>
                            <ComboBoxItem Content="Pieces"/>
                            <ComboBoxItem Content="Dozen"/>
                            <ComboBoxItem Content="Kilograms"/>
                            <ComboBoxItem Content="Spools"/>
                            <ComboBoxItem Content="Rolls"/>
                            <ComboBoxItem Content="Boxes"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                
                <TextBlock Text="Unit Price (Rs.) *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtUnitPrice" Style="{StaticResource InputField}" />
                
                <TextBlock Text="Supplier Name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtSupplierName" Style="{StaticResource InputField}" />
            </StackPanel>
        </ScrollViewer>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="100" Padding="10,8" 
                    Click="Cancel_Click" Background="#EEE" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Add Purchase" Width="120" Padding="10,8" Margin="10,0,0,0"
                    Click="Save_Click" Background="#4CAF50" Foreground="White" 
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
