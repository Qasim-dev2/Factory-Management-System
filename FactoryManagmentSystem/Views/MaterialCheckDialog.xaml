<Window x:Class="FactoryManagmentSystem.Views.MaterialCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Material Availability Check" 
        Height="550" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="SufficientBadge" TargetType="Border">
            <Setter Property="Background" Value="#D4EDDA"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="InsufficientBadge" TargetType="Border">
            <Setter Property="Background" Value="#F8D7DA"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                Padding="20,15" 
                CornerRadius="5"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Raw Material Availability Check" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock x:Name="txtOrderInfo" 
                           Text="Order Details" 
                           FontSize="14" 
                           Foreground="#BDC3C7"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Overall Status -->
        <Border Grid.Row="1" 
                x:Name="borderOverallStatus"
                Padding="15" 
                CornerRadius="5"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          x:Name="txtStatusIcon" 
                          FontSize="32"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtOverallStatus" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                    <TextBlock x:Name="txtStatusMessage" 
                               FontSize="14" 
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Materials DataGrid -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="5"
                BorderBrush="#DEE2E6"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        Padding="15,10"
                        BorderBrush="#DEE2E6"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Material Requirements Breakdown" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#495057"/>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="dgMaterials"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA"
                          BorderThickness="0"
                          HeadersVisibility="Column">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E9ECEF"/>
                            <Setter Property="Foreground" Value="#495057"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderBrush" Value="#DEE2E6"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" 
                                          Binding="{Binding ProductName}" 
                                          Width="150"/>

                        <DataGridTextColumn Header="Material" 
                                          Binding="{Binding MaterialName}" 
                                          Width="150"/>

                        <DataGridTextColumn Header="Required" 
                                          Binding="{Binding RequiredQuantityDisplay}" 
                                          Width="120"/>

                        <DataGridTextColumn Header="Available" 
                                          Binding="{Binding AvailableQuantityDisplay}" 
                                          Width="120"/>

                        <DataGridTextColumn Header="Shortage" 
                                          Binding="{Binding ShortageDisplay}" 
                                          Width="120"/>

                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSufficient}" Value="True">
                                                        <Setter Property="Background" Value="#D4EDDA"/>
                                                        <Setter Property="BorderBrush" Value="#28A745"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSufficient}" Value="False">
                                                        <Setter Property="Background" Value="#F8D7DA"/>
                                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="CornerRadius" Value="3"/>
                                                <Setter Property="Padding" Value="8,3"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" 
                                                 FontSize="11" 
                                                 FontWeight="SemiBold"
                                                 TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSufficient}" Value="True">
                                                            <Setter Property="Foreground" Value="#155724"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSufficient}" Value="False">
                                                            <Setter Property="Foreground" Value="#721C24"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="3"
                Content="Close"
                Width="120"
                Height="35"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Background="#6C757D"
                Foreground="White"
                FontWeight="SemiBold"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnClose_Click"/>
    </Grid>
</Window>
