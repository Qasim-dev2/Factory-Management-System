<UserControl x:Class="FactoryManagmentSystem.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="PrimaryDark" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#2D3142"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="HoverColor" Color="#F3F4F6"/>

        <!-- Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Margin="4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource HoverColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Tab Button Style -->
        <Style x:Key="ActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E5E7EB" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource TextSecondary}"/>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
        </Style>

        <!-- Warning Button Style -->
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentOrange}"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Stock Status Colors -->
        <Style x:Key="LowStockText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="HighStockText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundLight}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Tabs -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" 
                Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏷️" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Product Management" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Manage your garment products, inventory, and pricing" 
                                   FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tab Navigation -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Name="ViewAllTab" Content="📋 View All" Style="{StaticResource ActiveTabButtonStyle}" 
                            Click="TabButton_Click" Tag="ViewAll"/>
                    <Button Name="AddProductTab" Content="➕ Add Product" Style="{StaticResource TabButtonStyle}" 
                            Click="TabButton_Click" Tag="AddProduct"/>
                    <Button Name="UpdateProductTab" Content="✏️ Update Product" Style="{StaticResource TabButtonStyle}" 
                            Click="TabButton_Click" Tag="UpdateProduct"/>
                    <Button Name="DeleteProductTab" Content="🗑️ Delete Product" Style="{StaticResource TabButtonStyle}" 
                            Click="TabButton_Click" Tag="DeleteProduct"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <Grid>
                <!-- View All Products Content -->
                <Grid Name="ViewAllContent" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Statistics Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Total Products" FontSize="14" Foreground="{StaticResource TextSecondary}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Name="TotalProductsCount" Text="0" FontSize="28" FontWeight="Bold" 
                                           Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <TextBlock Text="👕" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Active Items" FontSize="14" Foreground="{StaticResource TextSecondary}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Name="ActiveProductsCount" Text="0" FontSize="28" FontWeight="Bold" 
                                           Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Search and Filter Section -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <TextBox Name="SearchTextBox" Style="{StaticResource ModernTextBoxStyle}" 
                                         TextChanged="SearchTextBox_TextChanged"/>
                                <TextBlock Name="SearchPlaceholder" Text="Search products by name, code, or material..." 
                                          Foreground="{StaticResource TextMuted}" FontSize="14"
                                          IsHitTestVisible="False" VerticalAlignment="Center" 
                                          Margin="14,0,0,0"/>
                            </Grid>

                            <ComboBox Name="CategoryFilterComboBox" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" 
                                     Margin="8,0" SelectionChanged="CategoryFilter_SelectionChanged"/>

                            <ComboBox Name="StatusFilterComboBox" Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}" 
                                     Margin="8,0" SelectionChanged="StatusFilter_SelectionChanged"/>

                            <ComboBox Name="SortByComboBox" Grid.Column="3" Style="{StaticResource ModernComboBoxStyle}" 
                                     Margin="8,0" SelectionChanged="SortBy_SelectionChanged"/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Name="SearchButton" Content="🔍 Search" Style="{StaticResource ActionButtonStyle}" 
                                       Click="SearchButton_Click" Margin="0,0,8,0"/>
                                <Button Name="RefreshButton" Content="🔄 Refresh" Style="{StaticResource SecondaryButtonStyle}" 
                                       Click="RefreshButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Products DataGrid -->
                    <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Product Catalog" FontSize="18" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                            <DataGrid Name="ProductsDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                                     IsReadOnly="True" GridLinesVisibility="None" HeadersVisibility="Column"
                                     CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                                     CanUserResizeColumns="True" CanUserSortColumns="True"
                                     Background="{StaticResource CardBackground}"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontSize="13" RowHeight="50">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="110"/>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="280"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                                    <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="160"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='Rs. {0:N0}'}" Width="130"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding ProductionStatus}" Width="140"/>
                                    <DataGridTemplateColumn Header="Actions" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="👁️" Style="{StaticResource ActionButtonStyle}" 
                                                           Width="32" Height="32" Margin="2" FontSize="12"
                                                           Click="ViewProduct_Click" Tag="{Binding ProductId}"
                                                           ToolTip="View Details"/>
                                                    <Button Content="✏️" Style="{StaticResource SuccessButtonStyle}" 
                                                           Width="32" Height="32" Margin="2" FontSize="12"
                                                           Click="EditProduct_Click" Tag="{Binding ProductId}"
                                                           ToolTip="Edit Product"/>
                                                    <Button Content="🗑️" Style="{StaticResource DangerButtonStyle}" 
                                                           Width="32" Height="32" Margin="2" FontSize="12"
                                                           Click="DeleteProduct_Click" Tag="{Binding ProductId}"
                                                           ToolTip="Delete Product"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Pagination -->
                    <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}" Margin="8,16,8,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Name="PaginationInfo" Text="Showing 0 of 0 products" 
                                          FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Name="PreviousPageButton" Content="← Previous" Style="{StaticResource SecondaryButtonStyle}" 
                                       Click="PreviousPage_Click" Margin="0,0,8,0" IsEnabled="False"/>
                                <TextBlock Name="PageNumberText" Text="Page 1 of 1" FontSize="14" 
                                          Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="8,0"/>
                                <Button Name="NextPageButton" Content="Next →" Style="{StaticResource SecondaryButtonStyle}" 
                                       Click="NextPage_Click" Margin="8,0,0,0" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Add Product Form -->
                <Grid Name="AddProductContent" Visibility="Collapsed">
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Form Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock Text="➕ Add New Product" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <TextBlock Text="Fill in the product details below to add a new garment to the catalog" 
                                           FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Form Fields -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Product Name -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Product Name *" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBox Name="AddProductNameTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>

                                    <!-- SKU -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,12,16">
                                        <TextBlock Text="SKU (Product Code) *" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBox Name="AddProductCodeTextBox" Style="{StaticResource ModernTextBoxStyle}" 
                                                 IsReadOnly="True" Background="#F3F4F6" 
                                                 ToolTip="Auto-generated product code (e.g., PC001, PC002)"/>
                                    </StackPanel>

                                    <!-- Category -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="12,0,0,16">
                                        <TextBlock Text="Category *" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <ComboBox Name="AddCategoryComboBox" Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Brand -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Brand" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBox Name="AddBrandTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Material -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,12,16">
                                        <TextBlock Text="Material *" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <ComboBox Name="AddMaterialComboBox" Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Selling Price -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="12,0,0,16">
                                        <TextBlock Text="Selling Price (Rs.) *" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBox Name="AddPriceTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Active Status -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Active Status" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <CheckBox Name="AddIsActiveCheckBox" Content="Product is Active" 
                                                  IsChecked="True" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Available Sizes -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Available Sizes" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <WrapPanel>
                                            <CheckBox Name="SizeXS" Content="XS" Margin="0,0,12,4"/>
                                            <CheckBox Name="SizeS" Content="S" Margin="0,0,12,4" IsChecked="True"/>
                                            <CheckBox Name="SizeM" Content="M" Margin="0,0,12,4" IsChecked="True"/>
                                            <CheckBox Name="SizeL" Content="L" Margin="0,0,12,4" IsChecked="True"/>
                                            <CheckBox Name="SizeXL" Content="XL" Margin="0,0,12,4" IsChecked="True"/>
                                            <CheckBox Name="SizeXXL" Content="XXL" Margin="0,0,12,4"/>
                                            <CheckBox Name="SizeXXXL" Content="3XL" Margin="0,0,12,4"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Available Colors -->
                                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,0,0,16">
                                        <TextBlock Text="Available Colors (comma-separated)" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBox Name="AddColorsTextBox" Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="White, Black, Navy, Gray"/>
                                    </StackPanel>

                                    <!-- Description -->
                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                        <TextBlock Text="Description" FontWeight="Medium" Margin="0,0,0,8" 
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBox Name="AddDescriptionTextBox" Style="{StaticResource ModernTextBoxStyle}" 
                                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>

                                    <!-- Material Requirements Section -->
                                    <Border Grid.Row="6" Grid.ColumnSpan="3" Margin="0,16,0,16" 
                                            Background="{StaticResource HoverColor}" CornerRadius="8" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="🔧 Material Requirements (Bill of Materials)" FontSize="18" FontWeight="Bold" 
                                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                                            
                                            <!-- Add Material Controls -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="Select Raw Material *" FontWeight="Medium" Margin="0,0,0,8"/>
                                                    <ComboBox Name="AddProductMaterialComboBox" Style="{StaticResource ModernComboBoxStyle}" 
                                                              DisplayMemberPath="MaterialName" SelectedValuePath="RawMaterialID"
                                                              SelectionChanged="AddProductMaterial_SelectionChanged"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock Text="Quantity Required *" FontWeight="Medium" Margin="0,0,0,8"/>
                                                    <TextBox Name="AddProductMaterialQuantityTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                    <TextBlock Text="Unit" FontWeight="Medium" Margin="0,0,0,8"/>
                                                    <TextBox Name="AddProductMaterialUnitTextBox" Style="{StaticResource ModernTextBoxStyle}" 
                                                             IsReadOnly="True" Background="#F3F4F6"/>
                                                </StackPanel>

                                                <Button Grid.Column="3" Content="➕ Add" VerticalAlignment="Bottom"
                                                        Style="{StaticResource SuccessButtonStyle}" 
                                                        Click="AddProductMaterialToList_Click" Width="80"/>
                                            </Grid>

                                            <!-- Materials List DataGrid -->
                                            <DataGrid Name="AddProductMaterialsDataGrid" AutoGenerateColumns="False" 
                                                     IsReadOnly="True" GridLinesVisibility="None"
                                                     CanUserAddRows="False" CanUserDeleteRows="False"
                                                     Background="{StaticResource CardBackground}"
                                                     FontSize="13" RowHeight="40" MaxHeight="250">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Material Name" Binding="{Binding MaterialName}" Width="*"/>
                                                    <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityRequired}" Width="100"/>
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                                                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}" Width="120"/>
                                                    <DataGridTextColumn Header="Total Cost" Binding="{Binding TotalCost, StringFormat='Rs. {0:N2}'}" Width="120"/>
                                                    <DataGridTemplateColumn Header="Actions" Width="80">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="🗑️" Style="{StaticResource DangerButtonStyle}" 
                                                                       Width="32" Height="32" FontSize="12"
                                                                       Click="RemoveProductMaterial_Click" Tag="{Binding RawMaterialID}"
                                                                       ToolTip="Remove Material"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Total Cost Display -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <TextBlock Text="Total Material Cost: " FontSize="16" FontWeight="Medium" 
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Name="AddProductTotalMaterialCostText" Text="Rs. 0.00" FontSize="16" FontWeight="Bold" 
                                                           Foreground="{StaticResource AccentPurple}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- Form Actions -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" 
                                        Margin="0,24,0,0">
                                <Button Name="ClearAddFormButton" Content="🔄 Clear Form" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Click="ClearAddForm_Click" Margin="0,0,12,0"/>
                                <Button Name="SaveProductButton" Content="💾 Save Product &amp; Materials" 
                                        Style="{StaticResource SuccessButtonStyle}" 
                                        Click="SaveProduct_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Update Product Form -->
                <Grid Name="UpdateProductContent" Visibility="Collapsed">
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Form Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock Text="✏️ Update Product" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <TextBlock Text="Search and select a product to update its details" 
                                           FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Product Search -->
                            <Border Grid.Row="1" Background="{StaticResource HoverColor}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="UpdateSearchTextBox" Style="{StaticResource ModernTextBoxStyle}" 
                                             TextChanged="UpdateSearch_TextChanged"/>
                                    <Button Grid.Column="1" Content="🔍 Find Product" Style="{StaticResource ActionButtonStyle}" 
                                            Click="FindProduct_Click" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Update Form Fields (similar to Add form but for updating) -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <Grid Name="UpdateFormGrid" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Product Name -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Product Name *" FontWeight="Medium" Margin="0,0,0,8"/>
                                        <TextBox Name="UpdateProductNameTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Category -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,12,16">
                                        <TextBlock Text="Category *" FontWeight="Medium" Margin="0,0,0,8"/>
                                        <ComboBox Name="UpdateCategoryComboBox" Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Selling Price -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="12,0,0,16">
                                        <TextBlock Text="Selling Price (Rs.) *" FontWeight="Medium" Margin="0,0,0,8"/>
                                        <TextBox Name="UpdatePriceTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Material -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Material" FontWeight="Medium" Margin="0,0,0,8"/>
                                        <ComboBox Name="UpdateMaterialComboBox" Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Active Status -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,16">
                                        <TextBlock Text="Active Status" FontWeight="Medium" Margin="0,0,0,8"/>
                                        <CheckBox Name="UpdateIsActiveCheckBox" Content="Product is Active" 
                                                  FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Description -->
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                        <TextBlock Text="Description" FontWeight="Medium" Margin="0,0,0,8"/>
                                        <TextBox Name="UpdateDescriptionTextBox" Style="{StaticResource ModernTextBoxStyle}" 
                                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- Form Actions -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" 
                                        Margin="0,24,0,0" Name="UpdateActionsPanel" Visibility="Collapsed">
                                <Button Content="❌ Cancel" Style="{StaticResource SecondaryButtonStyle}" 
                                        Click="CancelUpdate_Click" Margin="0,0,12,0"/>
                                <Button Content="💾 Update Product" Style="{StaticResource SuccessButtonStyle}" 
                                        Click="UpdateProduct_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Delete Product Content -->
                <Grid Name="DeleteProductContent" Visibility="Collapsed">
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock Text="🗑️ Delete Product" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <TextBlock Text="Search and select a product to permanently remove from the catalog" 
                                           FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Warning -->
                            <Border Grid.Row="1" Background="#FEF2F2" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Warning: Deletion is Permanent" FontWeight="Bold" 
                                                   Foreground="{StaticResource AccentRed}"/>
                                        <TextBlock Text="Deleted products cannot be recovered. All associated data will be removed." 
                                                   Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Products to Delete -->
                            <DataGrid Name="DeleteProductsDataGrid" Grid.Row="2" AutoGenerateColumns="False" 
                                     IsReadOnly="True" GridLinesVisibility="None"
                                     CanUserAddRows="False" CanUserDeleteRows="False"
                                     Background="{StaticResource CardBackground}"
                                     FontSize="13" RowHeight="50">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Width="40"/>
                                    <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="80"/>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="80"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='Rs. {0:N0}'}" Width="100"/>
                                    <DataGridTemplateColumn Header="Action" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" 
                                                       Width="90" Height="32" FontSize="12"
                                                       Click="ConfirmDeleteProduct_Click" Tag="{Binding ProductId}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
