<UserControl x:Class="FactoryManagmentSystem.Views.SimpleRevenueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#f8f9fa">

    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.1" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF9800"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#f44336"/>
        </Style>

        <!-- Tab Button Style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Date Range -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1565C0" Offset="0"/>
                    <GradientStop Color="#0D47A1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="💰 Revenue Dashboard" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Track Income, Expenses &amp; Profit" FontSize="13" Foreground="#B3E5FC" Margin="0,3,0,0"/>
                </StackPanel>
                
                <!-- Date Range Selector -->
                <Border Grid.Column="2" CornerRadius="8" Padding="15,10">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.15"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="From:" FontSize="11" Foreground="#B3E5FC" Margin="0,0,0,3"/>
                            <DatePicker x:Name="dpStartDate" Width="130" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="To:" FontSize="11" Foreground="#B3E5FC" Margin="0,0,0,3"/>
                            <DatePicker x:Name="dpEndDate" Width="130" FontSize="13"/>
                        </StackPanel>
                        <Button Content="📊 Calculate" Style="{StaticResource PrimaryButton}" 
                                Background="#00BCD4" Click="Calculate_Click" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Total Income -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="#4CAF50" BorderThickness="0,0,0,3">
                <StackPanel>
                    <TextBlock Text="📈 TOTAL INCOME" FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTotalIncome" Text="Rs. 0" FontSize="26" FontWeight="Bold" Foreground="#4CAF50" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="txtSalesCount" Text="Sales: Rs.0" FontSize="11" Foreground="#666"/>
                        <TextBlock Text=" | " FontSize="11" Foreground="#CCC"/>
                        <TextBlock x:Name="txtDealsCount" Text="Deals: Rs.0" FontSize="11" Foreground="#666"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Total Expenses -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="#F44336" BorderThickness="0,0,0,3">
                <StackPanel>
                    <TextBlock Text="📉 TOTAL EXPENSES" FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTotalExpense" Text="Rs. 0" FontSize="26" FontWeight="Bold" Foreground="#F44336" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="txtExpenseBreakdown" Text="Raw: Rs.0 | Misc: Rs.0" FontSize="11" Foreground="#666"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Net Profit -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="#2196F3" BorderThickness="0,0,0,3">
                <StackPanel>
                    <TextBlock Text="💵 NET PROFIT" FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtNetProfit" Text="Rs. 0" FontSize="26" FontWeight="Bold" Foreground="#2196F3" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtProfitMargin" Text="Margin: 0%" FontSize="11" Foreground="#666" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Salary Status -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" BorderBrush="#9C27B0" BorderThickness="0,0,0,3">
                <StackPanel>
                    <TextBlock Text="💳 SALARY STATUS" FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtSalaryStatus" Text="⏳ Pending" FontSize="18" FontWeight="Bold" Foreground="#9C27B0" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtSalaryAmount" Text="Rs. 0 (0 employees)" FontSize="11" Foreground="#666" Margin="0,8,0,0"/>
                    <Button x:Name="btnPaySalary" Content="Pay Salary" Style="{StaticResource SuccessButton}" 
                            FontSize="11" Padding="10,5" Margin="0,8,0,0" Click="PaySalary_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Tab Buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="tabSales" Content="📦 Sales Orders" Style="{StaticResource TabButton}" 
                            Click="TabSales_Click" BorderBrush="#2196F3" Foreground="#2196F3"/>
                    <Button x:Name="tabDeals" Content="🤝 Deals" Style="{StaticResource TabButton}" 
                            Click="TabDeals_Click"/>
                    <Button x:Name="tabPurchases" Content="🛒 Purchases" Style="{StaticResource TabButton}" 
                            Click="TabPurchases_Click"/>
                    <Button x:Name="tabExpenses" Content="💸 Expenses" Style="{StaticResource TabButton}" 
                            Click="TabExpenses_Click"/>
                </StackPanel>
                
                <!-- Add Buttons - Only Expense (Purchases are automated from Raw Material page) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="➕ Add Expense" Style="{StaticResource DangerButton}" 
                            Click="AddExpense_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid Section -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="10,5,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock x:Name="txtGridTitle" Text="📦 Sales Orders" FontSize="16" FontWeight="SemiBold" 
                           Foreground="#333" Margin="0,0,0,10"/>
                
                <!-- Sales Orders Grid -->
                <DataGrid x:Name="dgSalesOrders" Grid.Row="1" AutoGenerateColumns="False" 
                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0"
                          Background="Transparent" RowBackground="White" 
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding SalesOrderID}" Width="80"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=dd-MMM-yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Retailer" Binding="{Binding RetailerName}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=Rs. \{0:N0\}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Deals Grid -->
                <DataGrid x:Name="dgDeals" Grid.Row="1" AutoGenerateColumns="False" 
                          IsReadOnly="True" GridLinesVisibility="Horizontal" Visibility="Collapsed"
                          HeadersVisibility="Column" BorderThickness="0"
                          Background="Transparent" RowBackground="White" 
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Deal #" Binding="{Binding DealID}" Width="70"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding StartDate, StringFormat=dd-MMM-yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding DealTitle}" Width="*"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="150"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=Rs. \{0:N0\}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Purchases Grid -->
                <DataGrid x:Name="dgPurchases" Grid.Row="1" AutoGenerateColumns="False" 
                          IsReadOnly="True" GridLinesVisibility="Horizontal" Visibility="Collapsed"
                          HeadersVisibility="Column" BorderThickness="0"
                          Background="Transparent" RowBackground="White" 
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding PurchaseID}" Width="50"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat=dd-MMM-yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=Rs. \{0:N0\}}" Width="100"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=Rs. \{0:N0\}}" Width="110"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Expenses Grid -->
                <DataGrid x:Name="dgExpenses" Grid.Row="1" AutoGenerateColumns="False" 
                          IsReadOnly="True" GridLinesVisibility="Horizontal" Visibility="Collapsed"
                          HeadersVisibility="Column" BorderThickness="0"
                          Background="Transparent" RowBackground="White" 
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ExpenseID}" Width="50"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat=dd-MMM-yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Paid To" Binding="{Binding PaidTo}" Width="130"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=Rs. \{0:N0\}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Loading/Empty Message -->
                <TextBlock x:Name="txtNoData" Text="No data found for selected date range" 
                           Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#999" FontSize="14" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
