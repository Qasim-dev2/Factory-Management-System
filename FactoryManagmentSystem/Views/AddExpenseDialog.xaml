<Window x:Class="FactoryManagmentSystem.Views.NewExpenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Expense" Height="420" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f5f5f5">
    
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="💸 Add Expense" FontSize="20" FontWeight="Bold" Foreground="#F44336"/>
            <TextBlock Text="Record a miscellaneous expense" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Form -->
        <ScrollViewer Grid.Row="1" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Expense Date *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="dpExpenseDate" FontSize="13" Padding="5"/>
                
                <TextBlock Text="Amount (Rs.) *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtAmount" Style="{StaticResource InputField}" />
                
                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmbCategory" FontSize="13" Padding="8">
                    <ComboBoxItem Content="Utilities" IsSelected="True"/>
                    <ComboBoxItem Content="Rent"/>
                    <ComboBoxItem Content="Maintenance"/>
                    <ComboBoxItem Content="Transport"/>
                    <ComboBoxItem Content="Office Supplies"/>
                    <ComboBoxItem Content="Equipment"/>
                    <ComboBoxItem Content="Bonus"/>
                    <ComboBoxItem Content="Food/Tea"/>
                    <ComboBoxItem Content="Medical"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
                
                <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtDescription" Style="{StaticResource InputField}" 
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                
                <TextBlock Text="Paid To" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtPaidTo" Style="{StaticResource InputField}" />
            </StackPanel>
        </ScrollViewer>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="100" Padding="10,8" 
                    Click="Cancel_Click" Background="#EEE" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Add Expense" Width="120" Padding="10,8" Margin="10,0,0,0"
                    Click="Save_Click" Background="#F44336" Foreground="White" 
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
